---
import { nav, site, href } from '../data/site';

const base = import.meta.env.BASE_URL;
const raw = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname.replace(/^\//, '');
const current = `/${raw}`.replace(/\/+/g, '/');

function isActive(path) {
  if (!path) return current === '/';
  const normalized = `/${path}`.replace(/\/+/g, '/').replace(/\/$/, '');
  return current === normalized || current.startsWith(`${normalized}/`);
}
---

<header class="site-header" data-header>
  <div class="site-header__inner container">
    <a class="brand" href={href('')} aria-label="AIUWEI 首页">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <circle cx="16" cy="16" r="2.6" fill="currentColor" />
          <ellipse cx="16" cy="16" rx="13" ry="5.4" transform="rotate(-28 16 16)" stroke="currentColor" stroke-width="0.9" opacity="0.7" />
          <ellipse cx="16" cy="16" rx="13" ry="5.4" transform="rotate(34 16 16)" stroke="currentColor" stroke-width="0.9" opacity="0.35" />
          <circle cx="27.3" cy="9.4" r="1.3" fill="currentColor" />
        </svg>
      </span>
      <span class="brand__type">
        <span class="brand__name">AIUWEI</span>
        <span class="brand__sub">DEEP SPACE OBSERVATORY</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {nav.map((item) => (
        <a class:list={['nav__link', { 'is-active': isActive(item.path) }]} href={href(item.path)}>
          <span class="nav__en">{item.index} / {item.en}</span>
          <span class="nav__label">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header__meta">
      <span class="header__status">
        <span class="status-dot"></span>
        <span>SIGNAL LOCKED</span>
      </span>
      <a class="header__icon" href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub（新窗口打开）">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.57.1.78-.25.78-.55v-2.13c-3.17.69-3.84-1.34-3.84-1.34-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.73-1.54-2.53-.29-5.2-1.27-5.2-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.68 5.34-5.22 5.62.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.79.55A11.3 11.3 0 0 0 12 .7Z" />
        </svg>
      </a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">打开导航</span>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__top container">
    <span class="eyebrow"><span class="status-dot"></span> LINK ESTABLISHED</span>
    <button class="mobile-menu__close" type="button" data-menu-close aria-label="关闭导航">
      <span></span><span></span>
    </button>
  </div>

  <nav class="mobile-menu__nav container" aria-label="移动端主导航">
    {nav.map((item) => (
      <a class:list={['mobile-menu__link', { 'is-active': isActive(item.path) }]} href={href(item.path)}>
        <span class="mobile-menu__index">{item.index}</span>
        <span class="mobile-menu__label">{item.label}</span>
        <span class="mobile-menu__en">{item.en}</span>
      </a>
    ))}
  </nav>

  <div class="mobile-menu__bottom container">
    <p>AIUWEI OBSERVATORY<br /><span>记录者 / WEI_ER</span></p>
    <a href={site.github} target="_blank" rel="noreferrer">GITHUB ↗</a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.45s ease,
      border-color 0.45s ease,
      backdrop-filter 0.45s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(3, 6, 11, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
  }

  .brand__mark {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    color: var(--cyan);
    filter: drop-shadow(0 0 10px rgba(100, 244, 223, 0.35));
    transition: transform 0.6s var(--ease);
  }

  .brand:hover .brand__mark {
    transform: rotate(120deg);
  }

  .brand__mark svg {
    width: 100%;
    height: 100%;
  }

  .brand__type {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .brand__name {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  .brand__sub {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.19em;
    line-height: 1;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 38px);
  }

  .nav__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 0;
    color: var(--ink-muted);
    transition: color 0.3s ease;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 1px;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__en {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.16em;
    line-height: 1;
  }

  .nav__link.is-active .nav__en {
    color: var(--cyan);
    opacity: 0.8;
  }

  .nav__label {
    font-family: var(--font-cn);
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .header__meta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 0 0 auto;
  }

  .header__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.14em;
  }

  .header__icon {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    color: var(--ink-muted);
    transition: color 0.3s ease, transform 0.3s var(--ease);
  }

  .header__icon:hover {
    color: var(--cyan);
    transform: translateY(-2px);
  }

  .header__icon svg {
    width: 17px;
    height: 17px;
  }

  .menu-toggle {
    display: none;
    position: relative;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    color: var(--ink);
  }

  .menu-toggle span:not(.sr-only) {
    display: block;
    width: 20px;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s var(--ease), width 0.35s var(--ease);
  }

  .menu-toggle span:nth-of-type(2) {
    width: 13px;
    margin-left: 7px;
  }

  .menu-toggle:hover span:nth-of-type(2) {
    width: 20px;
    margin-left: 0;
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    padding: 20px 0 32px;
    background:
      radial-gradient(70% 60% at 80% 10%, rgba(46, 196, 182, 0.12), transparent 70%),
      rgba(3, 6, 11, 0.97);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition:
      opacity 0.4s var(--ease),
      visibility 0.4s,
      transform 0.4s var(--ease);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
  }

  .mobile-menu__close {
    position: relative;
    width: 44px;
    height: 44px;
    color: var(--ink);
  }

  .mobile-menu__close span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 1px;
    background: currentColor;
  }

  .mobile-menu__close span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .mobile-menu__close span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    margin-bottom: auto;
  }

  .mobile-menu__link {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    transition: color 0.3s ease, padding-left 0.4s var(--ease);
  }

  .mobile-menu__link:hover,
  .mobile-menu__link.is-active {
    padding-left: 8px;
    color: var(--ink);
  }

  .mobile-menu__index {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 9px;
    opacity: 0.65;
  }

  .mobile-menu__label {
    font-family: var(--font-cn);
    font-size: clamp(32px, 10vw, 52px);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .mobile-menu__en {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.14em;
  }

  .mobile-menu__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    line-height: 1.8;
  }

  .mobile-menu__bottom span {
    color: var(--ink-faint);
  }

  .mobile-menu__bottom a {
    color: var(--cyan);
  }

  @media (max-width: 1120px) {
    .nav {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 700px) {
    .header__status {
      display: none;
    }
    .header__meta {
      gap: 10px;
    }
    .brand__sub {
      display: none;
    }
    .brand__name {
      font-size: 16px;
    }
  }
</style>
