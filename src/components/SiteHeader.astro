---
import { nav, site, href } from '../data/site';

const base = import.meta.env.BASE_URL;
const raw = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname.replace(/^\//, '');
const current = `/${raw}`.replace(/\/+/g, '/');

function isActive(path) {
  if (!path) return current === '/';
  const normalized = `/${path}`.replace(/\/+/g, '/').replace(/\/$/, '');
  return current === normalized || current.startsWith(`${normalized}/`);
}
---

<header class="site-header" data-header>
  <div class="site-header__inner container">
    <a class="brand" href={href('')} aria-label="AIUWEI 首页">
      <span class="brand__mark" aria-hidden="true">A</span>
      <span class="brand__type">
        <span class="brand__name">AIUWEI</span>
        <span class="brand__sub">AI OBSERVATORY / ISSUE 001</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {nav.map((item) => (
        <a class:list={['nav__link', { 'is-active': isActive(item.path) }]} href={href(item.path)}>
          <span class="nav__index">{item.index}</span>
          <span class="nav__label">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header__meta">
      <span class="header__issue">ISSUE 001 / {site.established}</span>
      <a class="header__github" href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub（新窗口打开）">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.57.1.78-.25.78-.55v-2.13c-3.17.69-3.84-1.34-3.84-1.34-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.73-1.54-2.53-.29-5.2-1.27-5.2-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.68 5.34-5.22 5.62.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.79.55A11.3 11.3 0 0 0 12 .7Z" />
        </svg>
      </a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">打开导航</span>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__top container">
    <span class="kicker">AIUWEI / INDEX</span>
    <button class="mobile-menu__close" type="button" data-menu-close aria-label="关闭导航">
      <span></span><span></span>
    </button>
  </div>

  <nav class="mobile-menu__nav container" aria-label="移动端主导航">
    {nav.map((item) => (
      <a class:list={['mobile-menu__link', { 'is-active': isActive(item.path) }]} href={href(item.path)}>
        <span class="mobile-menu__index">{item.index}</span>
        <span class="mobile-menu__label">{item.label}</span>
        <span class="mobile-menu__en">{item.en}</span>
      </a>
    ))}
  </nav>

  <div class="mobile-menu__bottom container">
    <p class="label">AIUWEI OBSERVATORY<br />记录者 / WEI_ER</p>
    <a class="link" href={site.github} target="_blank" rel="noreferrer">GITHUB ↗</a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    height: var(--nav-h);
    border-bottom: 1px solid var(--ink);
    background: rgba(242, 238, 228, 0.93);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 26px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    flex: 0 0 auto;
  }

  .brand__mark {
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    border: 1px solid var(--ink);
    background: var(--acid);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .brand:hover .brand__mark {
    background: var(--blue);
    color: #fff;
    transform: rotate(-6deg);
  }

  .brand__type {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .brand__name {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .brand__sub {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    line-height: 1;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.2vw, 32px);
  }

  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 7px 0;
    border-bottom: 2px solid transparent;
    color: var(--ink-2);
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .nav__link:hover,
  .nav__link.is-active {
    border-color: var(--ink);
    background: var(--acid);
  }

  .nav__index {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1;
  }

  .nav__label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .header__meta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 0 0 auto;
  }

  .header__issue {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .header__github {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 1px solid transparent;
    color: var(--ink);
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .header__github:hover {
    border-color: var(--ink);
    background: var(--acid);
  }

  .header__github svg {
    width: 16px;
    height: 16px;
  }

  .menu-toggle {
    display: none;
    width: 36px;
    height: 36px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
  }

  .menu-toggle span:not(.sr-only) {
    display: block;
    width: 17px;
    height: 1px;
    background: var(--ink);
    transition: width 0.25s ease;
  }

  .menu-toggle span:nth-of-type(3) {
    width: 11px;
    margin-left: 6px;
  }

  .menu-toggle:hover span:nth-of-type(3) {
    width: 17px;
    margin-left: 0;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    padding: 18px 0 28px;
    background: var(--paper);
    background-image: radial-gradient(rgba(16, 16, 14, 0.13) 0.65px, transparent 0.65px);
    background-size: 16px 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.3s var(--ease), visibility 0.3s, transform 0.3s var(--ease);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    border-bottom: 1px solid var(--ink);
  }

  .mobile-menu__close {
    position: relative;
    width: 38px;
    height: 38px;
    border: 1px solid var(--ink);
    background: var(--acid);
  }

  .mobile-menu__close span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 1px;
    background: var(--ink);
  }

  .mobile-menu__close span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .mobile-menu__close span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    margin-block: auto;
  }

  .mobile-menu__link {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: baseline;
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    transition: background-color 0.25s ease, padding-left 0.3s var(--ease);
  }

  .mobile-menu__link:hover,
  .mobile-menu__link.is-active {
    padding-left: 8px;
    background: var(--acid);
    color: var(--ink);
  }

  .mobile-menu__index {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .mobile-menu__label {
    font-family: var(--font-serif);
    font-size: clamp(38px, 11vw, 58px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .mobile-menu__en {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .mobile-menu__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--ink);
  }

  .mobile-menu__bottom p {
    line-height: 1.7;
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 640px) {
    .header__issue {
      display: none;
    }

    .brand__sub {
      display: none;
    }

    .brand__name {
      font-size: 18px;
    }
  }
</style>
