---
import type { Project } from '../content/projects';

interface Props {
  project: Project;
  accent?: 'acid' | 'blue' | 'orange' | 'paper';
}

const { project, accent = 'acid' } = Astro.props;
const statusLabel = {
  active: '进行中',
  archived: '已归档',
  experiment: '实验中',
  planned: '计划中',
}[project.status] ?? '待定';
---

<article class:list={['project-card', `project-card--${accent}`]}>
  <div class="project-card__top">
    <span class="tag">{statusLabel}</span>
    <span class="label">{project.year}</span>
  </div>

  <h3 class="project-card__title">{project.title}</h3>
  <p class="project-card__desc">{project.description}</p>

  {project.stack.length > 0 && (
    <ul class="project-card__stack" aria-label="技术栈">
      {project.stack.map((item) => <li>{item}</li>)}
    </ul>
  )}

  <div class="project-card__foot">
    {project.link && <a class="link" href={project.link} target="_blank" rel="noreferrer">访问项目 ↗</a>}
    {project.repo && <a class="link" href={project.repo} target="_blank" rel="noreferrer">源码 ↗</a>}
    {!project.link && !project.repo && <span class="label">档案整理中</span>}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
    box-shadow: 5px 5px 0 var(--ink);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .project-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .project-card--acid {
    border-top: 8px solid var(--acid);
  }

  .project-card--blue {
    border-top: 8px solid var(--blue);
  }

  .project-card--orange {
    border-top: 8px solid var(--orange);
  }

  .project-card--paper {
    border-top: 8px solid var(--paper-2);
  }

  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .project-card__title {
    margin-top: 28px;
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .project-card__desc {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
  }

  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }

  .project-card__stack li {
    padding: 3px 6px;
    border: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .project-card__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: auto;
    padding-top: 24px;
  }

  .project-card__foot .label {
    color: var(--muted);
  }
</style>
