<section class="ai-game" data-ai-game aria-labelledby="ai-game-title">
  <div class="ai-game__head">
    <div>
      <p class="kicker">GAME 01 / HUMAN OR AI?</p>
      <h2 id="ai-game-title" class="ai-game__title">AI 真假判断</h2>
      <p class="ai-game__intro">两段文字，一段是人写的，一段是 AI 写的。选出 AI 那段。</p>
    </div>
    <div class="ai-game__meta">
      <span class="tag">6 题</span>
      <span class="tag">约 2 分钟</span>
      <span class="tag">无需操作技巧</span>
    </div>
  </div>

  <div class="ai-game__stage">
    <div class="ai-game__start" data-ai-start>
      <p class="label">HOW TO PLAY / 怎么玩</p>
      <h3>先读题，<br />再选 A 或 B。</h3>
      <p>
        每题会给你一个问题和两段回答。选出你认为由 AI 写的那段。答完会显示解析；最后按正确率给一个“AI 识别力”评分。
      </p>
      <p class="ai-game__disclaimer">说明：文本为游戏虚构，不代表真实作者或模型输出；请根据表达方式判断，而不是事实对错。</p>
      <button class="btn btn--solid ai-game__start-btn" type="button" data-ai-begin>
        <span>开始判断</span><span class="btn__arrow" aria-hidden="true">↗</span>
      </button>
    </div>

    <div class="ai-game__play" data-ai-play hidden>
      <div class="ai-game__bar">
        <span data-ai-progress>第 1 / 6 题</span>
        <span data-ai-score>0 分</span>
      </div>

      <p class="ai-game__prompt" data-ai-prompt></p>

      <div class="ai-game__choices">
        <button class="ai-choice" type="button" data-ai-choice="a">
          <span class="ai-choice__letter">A</span>
          <span class="ai-choice__text" data-ai-a></span>
        </button>
        <button class="ai-choice" type="button" data-ai-choice="b">
          <span class="ai-choice__letter">B</span>
          <span class="ai-choice__text" data-ai-b></span>
        </button>
      </div>

      <div class="ai-game__feedback" data-ai-feedback hidden aria-live="polite">
        <p class="ai-game__verdict" data-ai-verdict></p>
        <p class="ai-game__explain" data-ai-explain></p>
        <button class="btn" type="button" data-ai-next><span>下一题</span><span class="btn__arrow" aria-hidden="true">→</span></button>
      </div>
    </div>

    <div class="ai-game__result" data-ai-result hidden aria-live="polite">
      <p class="label">RESULT / 判断结束</p>
      <p class="ai-game__result-score" data-ai-result-score>0 / 6</p>
      <h3 data-ai-result-title>你的 AI 识别力</h3>
      <p data-ai-result-note></p>
      <div class="ai-game__result-actions">
        <button class="btn btn--solid" type="button" data-ai-replay><span>再玩一次</span><span class="btn__arrow" aria-hidden="true">↻</span></button>
        <a class="btn" href="#token-match"><span>去玩 Token 配对</span><span class="btn__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/ai-or-human.js';
</script>

