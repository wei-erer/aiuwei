---
interface Props {
  index: string;
  en: string;
  title: string;
  titleEn?: string;
  description: string;
  meta?: string[];
  stamp?: string;
}

const { index, en, title, titleEn, description, meta = [], stamp } = Astro.props;
---

<section class="page-head">
  <div class="container">
    <div class="page-head__top">
      <p class="kicker">{en}</p>
      <span class="page-head__index">{index} / 04</span>
    </div>

    <div class="page-head__main">
      <div>
        <h1 class="page-head__title">
          {titleEn && <span class="page-head__title-en">{titleEn}</span>}
          {title}
        </h1>
        {meta.length > 0 && (
          <div class="page-head__meta">
            {meta.map((item) => <span class="tag">{item}</span>)}
          </div>
        )}
      </div>
      <div>
        <p class="page-head__desc">{description}</p>
      </div>
    </div>
  </div>
  {stamp && <div class="page-head__stamp" aria-hidden="true">{stamp}</div>}
</section>
