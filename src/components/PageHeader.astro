---
interface Props {
  index?: string;
  label: string;
  title: string;
  titleEn?: string;
  description?: string;
  meta?: string[];
}

const { index = '00', label, title, titleEn, description, meta = [] } = Astro.props;
---

<header class="page-hero">
  <div class="page-hero__scene" aria-hidden="true">
    <div class="page-hero__stars"></div>
    <div class="page-hero__planet"></div>
    <div class="page-hero__atmosphere"></div>
    <svg class="page-hero__orbit" viewBox="0 0 1200 600" fill="none">
      <ellipse cx="760" cy="300" rx="540" ry="170" transform="rotate(-11 760 300)" stroke="currentColor" stroke-width="1" opacity=".22" />
      <ellipse cx="760" cy="300" rx="430" ry="132" transform="rotate(-11 760 300)" stroke="currentColor" stroke-width="1" opacity=".16" stroke-dasharray="2 10" />
      <path d="M300 300h250M1040 300h80" stroke="currentColor" stroke-width="1" opacity=".18" />
    </svg>

    <svg class="page-hero__station" viewBox="0 0 1100 560" fill="none">
      <defs>
        <linearGradient id="page-metal" x1="80" y1="100" x2="1000" y2="490">
          <stop stop-color="#effbff" stop-opacity=".85" />
          <stop offset=".45" stop-color="#8fb3c5" stop-opacity=".45" />
          <stop offset="1" stop-color="#d9f6ff" stop-opacity=".55" />
        </linearGradient>
      </defs>
      <g transform="rotate(-12 620 280)" opacity=".7">
        <ellipse cx="620" cy="280" rx="470" ry="132" stroke="url(#page-metal)" stroke-width="1.6" />
        <ellipse cx="620" cy="280" rx="470" ry="132" stroke="#9feaff" stroke-width="1" stroke-dasharray="1 11" opacity=".6" />
        <ellipse cx="620" cy="280" rx="380" ry="104" stroke="url(#page-metal)" stroke-width="1" opacity=".45" />
        <g stroke="#b9edff" stroke-width="1" opacity=".3">
          <path d="M620 280V150M620 280V410M180 280h220M840 280h220M930 373L760 320M300 190l180 60" />
        </g>
        <g fill="#dff8ff" opacity=".8">
          <rect x="612" y="136" width="16" height="30" rx="2" />
          <rect x="612" y="394" width="16" height="30" rx="2" />
          <rect x="1000" y="273" width="30" height="14" rx="2" />
          <rect x="210" y="273" width="30" height="14" rx="2" />
        </g>
        <circle cx="620" cy="280" r="44" stroke="url(#page-metal)" stroke-width="1.2" />
        <circle cx="620" cy="280" r="18" fill="rgba(5,17,29,.9)" stroke="#b9edff" stroke-width="1.2" />
        <circle cx="620" cy="280" r="4" fill="#b9f3ff" />
      </g>
    </svg>
  </div>

  <div class="page-hero__inner container">
    <div class="page-hero__top">
      <span class="label">{label}</span>
      <span class="label">{index}</span>
    </div>

    <div class="page-hero__main">
      <div>
        {titleEn && <p class="kicker">{titleEn}</p>}
        <h1 class="page-hero__title">{title}</h1>
        {meta.length > 0 && (
          <ul class="page-hero__meta" aria-label="页面信息">
            {meta.map((item) => <li class="tag">{item}</li>)}
          </ul>
        )}
      </div>
      {description && <p class="page-hero__desc">{description}</p>}
    </div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(440px, 58vh, 620px);
    padding-top: calc(var(--nav-h) + clamp(50px, 8vw, 100px));
    padding-bottom: clamp(48px, 7vw, 86px);
    border-bottom: 1px solid var(--line);
  }

  .page-hero__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .page-hero__scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(2, 6, 13, 0.88) 0%, rgba(2, 6, 13, 0.28) 58%, rgba(2, 6, 13, 0.62) 100%),
      linear-gradient(to bottom, rgba(2, 6, 13, 0.55), transparent 38%, rgba(2, 6, 13, 0.72));
  }

  .page-hero__stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(220, 242, 255, 0.7) 0.7px, transparent 0.7px),
      radial-gradient(rgba(160, 220, 250, 0.55) 0.6px, transparent 0.6px);
    background-size: 73px 61px, 131px 97px;
    background-position: 11px 17px, 47px 38px;
    opacity: 0.42;
  }

  .page-hero__planet {
    position: absolute;
    right: -320px;
    bottom: -900px;
    width: 1400px;
    height: 1400px;
    border-radius: 50%;
    background:
      radial-gradient(ellipse 18% 5% at 60% 40%, rgba(231, 252, 255, 0.16), rgba(10, 45, 68, 0.2) 46%, transparent 72%),
      radial-gradient(
        circle at 30% 24%,
        rgba(225, 250, 255, 0.85) 0,
        rgba(125, 215, 250, 0.55) 7%,
        rgba(38, 112, 158, 0.4) 25%,
        rgba(7, 35, 58, 0.55) 54%,
        rgba(1, 6, 12, 0.9) 76%
      );
    opacity: 0.62;
  }

  .page-hero__planet::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      repeating-linear-gradient(
        9deg,
        transparent 0 28px,
        rgba(208, 246, 255, 0.07) 29px 33px,
        transparent 34px 76px
      ),
      repeating-linear-gradient(
        4deg,
        transparent 0 55px,
        rgba(2, 18, 32, 0.13) 56px 66px,
        transparent 67px 128px
      );
    mix-blend-mode: screen;
    opacity: 0.6;
  }

  .page-hero__planet::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(116deg, transparent 8%, rgba(0, 4, 10, 0.16) 44%, rgba(0, 2, 7, 0.68) 100%);
  }

  .page-hero__atmosphere {
    position: absolute;
    right: -345px;
    bottom: -870px;
    width: 1450px;
    height: 1450px;
    border-radius: 50%;
    border: 1px solid rgba(170, 232, 255, 0.38);
    box-shadow: 0 0 60px rgba(110, 210, 255, 0.12);
  }

  .page-hero__orbit {
    position: absolute;
    right: -60px;
    top: 15%;
    width: min(1100px, 90vw);
    color: var(--cyan);
    opacity: 0.7;
  }

  .page-hero__station {
    position: absolute;
    right: -80px;
    top: 13%;
    width: min(820px, 66vw);
    opacity: 0.3;
    filter: drop-shadow(0 0 16px rgba(100, 205, 245, 0.12));
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
  }

  .page-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .page-hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
    gap: clamp(30px, 7vw, 100px);
    align-items: end;
    padding-top: clamp(34px, 6vw, 72px);
  }

  .page-hero__title {
    margin-top: 14px;
    color: var(--ice);
    font-size: clamp(52px, 8.2vw, 118px);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 0.9;
  }

  .page-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 26px;
  }

  .page-hero__desc {
    max-width: 34ch;
    padding-bottom: 6px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
    text-shadow: 0 1px 22px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 800px) {
    .page-hero {
      min-height: 0;
      padding-top: calc(var(--nav-h) + 46px);
      padding-bottom: 46px;
    }

    .page-hero__main {
      grid-template-columns: 1fr;
      gap: 22px;
      align-items: start;
      padding-top: 28px;
    }

    .page-hero__title {
      font-size: clamp(44px, 13vw, 76px);
    }

    .page-hero__desc {
      max-width: 40ch;
      font-size: 15px;
    }

    .page-hero__planet {
      right: -480px;
      bottom: -780px;
      opacity: 0.38;
    }

    .page-hero__orbit {
      right: -280px;
      top: 22%;
      width: 900px;
    }

    .page-hero__station {
      right: -330px;
      top: 26%;
      width: 720px;
      opacity: 0.18;
    }
  }
</style>
