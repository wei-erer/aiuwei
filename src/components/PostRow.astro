---
import { href } from '../data/site';
import { formatDate } from '../lib/content';

interface Props {
  post: any;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const date = formatDate(post.data.pubDate);

const number = String(index + 1).padStart(2, '0');
---

<a class="post-row" href={href(`writing/${post.slug}/`)}>
  <span class="post-row__index">{number}</span>
  <span class="post-row__main">
    <span class="post-row__meta">
      <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      {post.data.tags.length > 0 && (
        <span class="post-row__tags">
          {post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}
        </span>
      )}
    </span>
    <span class="post-row__title">{post.data.title}</span>
    {post.data.description && <span class="post-row__desc">{post.data.description}</span>}
  </span>
  <span class="post-row__arrow" aria-hidden="true">↗</span>
</a>

<style>
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) 24px;
    gap: 18px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    transition: padding-left 0.45s var(--ease), border-color 0.3s ease;
  }

  .post-row:hover {
    padding-left: 8px;
    border-color: var(--line-strong);
  }

  .post-row__index {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 9px;
    opacity: 0.55;
  }

  .post-row__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .post-row__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .post-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .post-row__tags span {
    color: var(--cyan);
    opacity: 0.6;
  }

  .post-row__title {
    color: var(--ink);
    font-family: var(--font-cn);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .post-row:hover .post-row__title {
    color: var(--cyan);
  }

  .post-row__desc {
    max-width: 62ch;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 13px;
    line-height: 1.8;
  }

  .post-row__arrow {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 13px;
    transition: color 0.3s ease, transform 0.3s var(--ease);
  }

  .post-row:hover .post-row__arrow {
    color: var(--cyan);
    transform: translate(3px, -3px);
  }

  @media (max-width: 560px) {
    .post-row {
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 12px;
    }
    .post-row__arrow {
      display: none;
    }
  }
</style>
