      <span class="status-dot"></span>
      <span>EXPERIMENT 001</span>
      <span class="loss-game__slash">/</span>
      <span>LOSS VALLEY</span>
      <span class="tag">LIVE</span>
    </div>
    <div class="loss-game__top-status">
      <span data-game-status>READY</span>
      <span>ATTEMPT <strong data-game-attempt>00</strong></span>
    </div>
  </div>

  <div class="loss-game__grid">
    <div class="loss-game__screen panel">
      <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>

      <div class="loss-game__screen-head">
        <div class="loss-game__level">
          <span data-game-level-code>LEVEL 01</span>
          <strong data-game-level-name>FIRST LIGHT</strong>
          <em data-game-level-cn>第一道信号</em>
        </div>
        <div class="loss-game__readouts">
          <span>STEP <strong data-game-step>000</strong><i>/</i><span data-game-total>140</span></span>
          <span>LOSS <strong data-game-loss>0.663</strong></span>
          <span>VEL <strong data-game-velocity>0.000</strong></span>
        </div>
      </div>

      <div class="loss-game__canvas-wrap" data-game-canvas-wrap>
        <canvas
          data-game-canvas
          role="img"
          aria-label="损失地形图。调整学习率与动量，让参数球进入全局最优区域。"
        ></canvas>
        <div class="loss-game__scan" aria-hidden="true"></div>
        <div class="loss-game__legend" aria-hidden="true">
          <span><i class="loss-game__dot loss-game__dot--start"></i> x₀ START</span>
          <span><i class="loss-game__dot loss-game__dot--min"></i> LOCAL MIN</span>
          <span><i class="loss-game__dot loss-game__dot--target"></i> GLOBAL MIN</span>
        </div>
      </div>

      <div class="loss-game__screen-foot">
        <span class="loss-game__objective">OBJECTIVE // <span data-game-objective>一个凸谷。找到既不会太慢、也不会冲过头的步长。</span></span>
        <span class="loss-game__stars" data-game-stars aria-label="本关最佳星级">
          <i></i><i></i><i></i>
        </span>
      </div>
    </div>

    <aside class="loss-game__panel panel">
      <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>

      <div class="loss-game__levels" aria-label="关卡">
        <button class="loss-game__level-tab is-active" type="button" data-level-button data-level="0" aria-pressed="true">
          <span>01</span>
          <strong>FIRST LIGHT</strong>
          <em data-level-lock>OPEN</em>
        </button>
        <button class="loss-game__level-tab is-locked" type="button" data-level-button data-level="1" aria-pressed="false">
          <span>02</span>
          <strong>FALSE VALLEY</strong>
          <em data-level-lock>LOCKED</em>
        </button>
        <button class="loss-game__level-tab is-locked" type="button" data-level-button data-level="2" aria-pressed="false">
          <span>03</span>
          <strong>THE RAVINE</strong>
          <em data-level-lock>LOCKED</em>
        </button>
      </div>

      <div class="loss-game__control-block">
        <div class="loss-game__slider-head">
          <span>LEARNING RATE</span>
          <strong data-game-lr-value>η 0.080</strong>
        </div>
        <input
          type="range"
          min="0.005"
          max="0.35"
          step="0.005"
          value="0.08"
          data-game-lr
          aria-label="学习率"
          aria-valuetext="学习率 0.080"
        />
        <div class="loss-game__scale"><span>0.005</span><span>0.350</span></div>
      </div>

      <div class="loss-game__control-block">
        <div class="loss-game__slider-head">
          <span>MOMENTUM</span>
          <strong data-game-beta-value>β 0.00</strong>
        </div>
        <input
          type="range"
          min="0"
          max="0.99"
          step="0.01"
          value="0"
          data-game-beta
          aria-label="动量"
          aria-valuetext="动量 0.00"
        />
        <div class="loss-game__scale"><span>0.00</span><span>0.99</span></div>
      </div>

      <div class="loss-game__buttons">
        <button class="loss-game__run" type="button" data-game-run>
          <span data-run-label>RUN DESCENT</span>
          <span aria-hidden="true">↵</span>
        </button>
        <button class="loss-game__small" type="button" data-game-reset>RESET</button>
        <button class="loss-game__small" type="button" data-game-hint>HINT</button>
      </div>

      <div class="loss-game__status">
        <div>
          <span>STATUS</span>
          <strong data-game-message>READY // 等待参数</strong>
        </div>
        <div>
          <span>RECORD</span>
          <strong data-game-best>BEST —</strong>
        </div>
      </div>

      <div class="loss-game__hint">
        <div class="loss-game__hint-head">
          <span>AIUWEI // ADVISORY</span>
          <span>HINT</span>
        </div>
        <p data-game-hint-text>从一个中等步长开始。太小会走得很慢，太大则会在谷底来回振荡。</p>
      </div>

      <button class="loss-game__next" type="button" data-game-next>
        <span>NEXT TERRAIN</span>
        <span aria-hidden="true">→</span>
      </button>

      <div class="loss-game__shortcuts">
        <span>SPACE RUN / PAUSE</span>
        <span>R RESET</span>
        <span>H HINT</span>
      </div>
    </aside>
  </div>

  <div class="sr-only" data-game-live aria-live="polite"></div>
</div>

<script>
  import { initLossValley } from '../scripts/gradient-game.js';
  initLossValley();
</script>

