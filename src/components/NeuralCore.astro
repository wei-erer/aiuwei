---
interface Props {
  nodes?: number;
  interactive?: boolean;
}

const { nodes = 128, interactive = true } = Astro.props;
---

<div
  class="neural-core"
  data-neural-core
  data-nodes={nodes}
  data-interactive={String(interactive)}
  aria-hidden="true"
>
  <div class="neural-core__halo"></div>
  <canvas></canvas>
</div>

<script>
  import { initNeuralCore } from '../scripts/neural-core.js';
  initNeuralCore();
</script>

<style>
  .neural-core {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    isolation: isolate;
  }

  .neural-core__halo {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(100, 244, 223, 0.1), transparent 62%);
    filter: blur(28px);
    animation: core-breathe 7s ease-in-out infinite;
  }

  .neural-core canvas {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  @keyframes core-breathe {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .neural-core__halo {
      animation: none;
    }
  }
</style>
