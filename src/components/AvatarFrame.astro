---
import { href } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={['avatar-card', { 'avatar-card--compact': compact }]} data-reveal>
  <span class="avatar-card__tape" aria-hidden="true"></span>
  <div class="avatar-card__image">
    <img
      src={href('images/avatar.jpg')}
      alt="wei_er 的插画头像"
      width="640"
      height="640"
      loading={compact ? 'lazy' : 'eager'}
      decoding="async"
    />
  </div>
  <figcaption>
    <span class="label">OBSERVER / 001</span>
    <strong>WEI_ER</strong>
  </figcaption>
</figure>

<style>
  .avatar-card {
    position: relative;
    width: min(100%, 420px);
    margin: 0;
    padding: 12px 12px 0;
    border: 1px solid var(--ink);
    background: var(--paper-3);
    box-shadow: 6px 6px 0 var(--acid);
    transform: rotate(-1.5deg);
  }

  .avatar-card__tape {
    position: absolute;
    top: -12px;
    left: 50%;
    z-index: 2;
    width: 96px;
    height: 24px;
    border: 1px solid rgba(16, 16, 14, 0.16);
    background: rgba(255, 255, 255, 0.58);
    transform: translateX(-50%) rotate(2deg);
    backdrop-filter: blur(1px);
  }

  .avatar-card__image {
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--paper-2);
  }

  .avatar-card__image img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.4s ease, transform 0.5s var(--ease);
  }

  .avatar-card:hover .avatar-card__image img {
    filter: grayscale(0) contrast(1.02);
    transform: scale(1.02);
  }

  .avatar-card figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 2px 14px;
  }

  .avatar-card figcaption strong {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .avatar-card--compact {
    width: min(100%, 300px);
  }

  @media (max-width: 560px) {
    .avatar-card {
      width: min(100%, 320px);
    }
  }
</style>
