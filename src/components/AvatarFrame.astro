---
import { href } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={['avatar-frame', { 'avatar-frame--compact': compact }]} data-reveal>
  <span class="avatar-frame__corner avatar-frame__corner--tl" aria-hidden="true"></span>
  <span class="avatar-frame__corner avatar-frame__corner--tr" aria-hidden="true"></span>
  <span class="avatar-frame__corner avatar-frame__corner--bl" aria-hidden="true"></span>
  <span class="avatar-frame__corner avatar-frame__corner--br" aria-hidden="true"></span>

  <div class="avatar-frame__orbit avatar-frame__orbit--outer" aria-hidden="true"></div>
  <div class="avatar-frame__orbit avatar-frame__orbit--inner" aria-hidden="true"></div>

  <div class="avatar-frame__inner">
    <img
      src={href('images/avatar-signal.webp')}
      alt="wei_er 的插画头像，经过青色双色调处理"
      width="640"
      height="640"
      loading={compact ? 'lazy' : 'eager'}
      decoding="async"
    />
    <span class="avatar-frame__scan" aria-hidden="true"></span>
  </div>

  <div class="avatar-frame__label avatar-frame__label--top" aria-hidden="true">
    <span>VISUAL ID</span>
    <span>001</span>
  </div>
  <div class="avatar-frame__label avatar-frame__label--bottom" aria-hidden="true">
    <span>OBSERVER // WEI_ER</span>
    <span>SYNC 98.2%</span>
  </div>
</figure>

<style>
  .avatar-frame {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin: 0;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .avatar-frame::before {
    content: '';
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(100, 244, 223, 0.16), transparent 66%);
    filter: blur(30px);
    z-index: -1;
  }

  .avatar-frame__inner {
    position: relative;
    width: 74%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg-soft);
    box-shadow:
      0 0 0 9px rgba(3, 6, 11, 0.8),
      0 0 0 10px rgba(100, 244, 223, 0.12),
      0 0 64px rgba(46, 196, 182, 0.1);
  }

  .avatar-frame__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      linear-gradient(to bottom, transparent 30%, rgba(3, 6, 11, 0.28) 100%),
      radial-gradient(circle at 50% 50%, transparent 55%, rgba(3, 6, 11, 0.4) 100%);
    pointer-events: none;
  }

  .avatar-frame__inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.03);
  }

  .avatar-frame__scan {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(100, 244, 223, 0.055) 3px,
      rgba(100, 244, 223, 0.055) 4px
    );
    mix-blend-mode: screen;
    opacity: 0.55;
    pointer-events: none;
  }

  .avatar-frame__orbit {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .avatar-frame__orbit--outer {
    inset: 3%;
    border: 1px dashed rgba(100, 244, 223, 0.22);
    animation: orbit-spin 42s linear infinite;
  }

  .avatar-frame__orbit--inner {
    inset: 11%;
    border: 1px solid rgba(109, 140, 255, 0.16);
    border-left-color: rgba(100, 244, 223, 0.5);
    transform: rotate(24deg);
    animation: orbit-spin-reverse 26s linear infinite;
  }

  .avatar-frame__orbit--outer::before,
  .avatar-frame__orbit--inner::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px rgba(100, 244, 223, 0.8);
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbit-spin-reverse {
    from {
      transform: rotate(24deg);
    }
    to {
      transform: rotate(-336deg);
    }
  }

  .avatar-frame__corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--line-strong);
    border-style: solid;
    pointer-events: none;
  }

  .avatar-frame__corner--tl {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }

  .avatar-frame__corner--tr {
    top: 0;
    right: 0;
    border-width: 1px 1px 0 0;
  }

  .avatar-frame__corner--bl {
    bottom: 0;
    left: 0;
    border-width: 0 0 1px 1px;
  }

  .avatar-frame__corner--br {
    bottom: 0;
    right: 0;
    border-width: 0 1px 1px 0;
  }

  .avatar-frame__label {
    position: absolute;
    left: 9%;
    right: 9%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
  }

  .avatar-frame__label--top {
    top: 2%;
  }

  .avatar-frame__label--bottom {
    bottom: 1%;
  }

  .avatar-frame__label span:last-child {
    color: var(--cyan);
    opacity: 0.7;
  }

  .avatar-frame--compact {
    width: min(100%, 300px);
  }

  @media (max-width: 560px) {
    .avatar-frame {
      width: min(100%, 320px);
    }
    .avatar-frame__label {
      font-size: 6px;
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-frame__orbit {
      animation: none;
    }
  }
</style>
