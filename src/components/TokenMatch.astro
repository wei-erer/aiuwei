    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
    opacity: 0;
    transform: translateY(4px);
  }

  .match-card.is-flipped {
    background: var(--paper-3);
    color: var(--ink);
  }

  .match-card.is-flipped .match-card__front {
    opacity: 0;
