---
interface Props {
  index: string;
  en: string;
  title: string;
  link?: string;
  linkLabel?: string;
}

const { index, en, title, link, linkLabel = '查看全部' } = Astro.props;
---

<div class="section-head" data-reveal>
  <span class="section-head__index" aria-hidden="true">{index}</span>
  <div>
    <p class="section-head__en">{en}</p>
    <h2 class="section-head__title">{title}</h2>
  </div>
  {link && (
    <a class="section-head__link" href={link}>
      <span>{linkLabel}</span>
      <span aria-hidden="true">↗</span>
    </a>
  )}
</div>
