---
import { nav, site, href } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__marquee marquee" aria-hidden="true">
    <div class="marquee__inner">
      <div class="marquee__group">
        <span>AIUWEI OBSERVATORY</span><span>ISSUE 001</span><span>AI / AGENT / ALIGNMENT</span><span>记录智能的微光</span>
      </div>
      <div class="marquee__group">
        <span>AIUWEI OBSERVATORY</span><span>ISSUE 001</span><span>AI / AGENT / ALIGNMENT</span><span>记录智能的微光</span>
      </div>
    </div>
  </div>

  <div class="site-footer__main container">
    <div class="site-footer__brand">
      <p class="label">OBSERVATORY / {site.established}</p>
      <p class="site-footer__name">AIUWEI</p>
      <p class="site-footer__tagline">{site.tagline}</p>
      <p class="site-footer__author">记录者 / <strong>WEI_ER</strong></p>
    </div>

    <div class="site-footer__nav-group">
      <p class="site-footer__label">INDEX</p>
      <nav class="site-footer__nav" aria-label="页脚导航">
        {nav.map((item) => (
          <a href={href(item.path)}><span>{item.label}</span><span>{item.en}</span></a>
        ))}
      </nav>
    </div>

    <div class="site-footer__uplink">
      <p class="site-footer__label">UPLINK</p>
      <a href={site.github} target="_blank" rel="noreferrer">GITHUB <span>↗</span></a>
      <a href={href('rss.xml')}>RSS <span>↗</span></a>
      <a href={`${href('')}?cover=1`}>重播封面 <span>↻</span></a>
      <a href="#top">回到顶部 <span>↑</span></a>
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p>© {year} WEI_ER / AIUWEI OBSERVATORY</p>
    <p>ISSUE 001 · BUILT ON PAPER</p>
    <p>ALL SIGNALS RESERVED</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--ink);
    background: var(--paper);
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(180px, 0.55fr) minmax(170px, 0.45fr);
    gap: clamp(30px, 6vw, 100px);
    padding-top: clamp(48px, 7vw, 84px);
    padding-bottom: clamp(48px, 7vw, 80px);
  }

  .site-footer__name {
    margin-top: 20px;
    font-family: var(--font-sans);
    font-size: clamp(54px, 7vw, 104px);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 0.8;
  }

  .site-footer__tagline {
    max-width: 20em;
    margin-top: 18px;
    color: var(--ink-2);
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.7;
  }

  .site-footer__author {
    margin-top: 20px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .site-footer__author strong {
    color: var(--ink);
    font-weight: 500;
  }

  .site-footer__label {
    margin-bottom: 14px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .site-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .site-footer__nav a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    color: var(--ink-2);
    font-size: 15px;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .site-footer__nav a span:last-child {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  .site-footer__nav a:hover {
    border-color: var(--ink);
    background: var(--acid);
  }

  .site-footer__uplink {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .site-footer__uplink a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    transition: background-color 0.25s ease;
  }

  .site-footer__uplink a:hover {
    background: var(--acid);
    color: var(--ink);
  }

  .site-footer__uplink span {
    font-size: 13px;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 14px;
    padding-bottom: 20px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  @media (max-width: 880px) {
    .site-footer__main {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }

    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }

  @media (max-width: 520px) {
    .site-footer__main {
      grid-template-columns: 1fr;
    }

    .site-footer__name {
      font-size: 58px;
    }
  }
</style>
