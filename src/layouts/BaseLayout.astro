---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';

import Starfield from '../components/Starfield.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IntroOverlay from '../components/IntroOverlay.astro';
import { site, href } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  intro?: boolean;
  image?: string;
}

const {
  title,
  description = site.description,
  intro = false,
  image = href('og.png'),
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonicalUrl = new URL(Astro.url.pathname, site.origin).toString();
const imageUrl = new URL(image, site.origin).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      url: new URL(href(''), site.origin).toString(),
      description: site.description,
      author: { '@type': 'Person', name: site.author, url: site.github },
    },
    {
      '@type': 'Person',
      name: site.author,
      alternateName: site.aiAlias,
      url: site.origin,
      sameAs: [site.github],
    },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#03060b" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · RSS`} href={href('rss.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const seen = sessionStorage.getItem('aiuwei:intro-seen') === '1';
        const forced = new URLSearchParams(location.search).has('intro');
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if ((seen && !forced) || reduced) {
          document.documentElement.classList.add('intro-skip');
        }
      } catch (_) {
        /* sessionStorage may be unavailable. */
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body id="top" class:list={[{ 'has-intro': intro }]}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>

    <Starfield />
    <SiteHeader />

    <main id="main" class="page">
      <slot />
    </main>

    <SiteFooter />
    {intro && <IntroOverlay />}

    <script>
      import '../scripts/ui.js';
    </script>
  </body>
</html>
