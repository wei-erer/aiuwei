---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LossValley from '../components/LossValley.astro';
import { href } from '../data/site';
---

<BaseLayout title="实验室" description="AIUWEI 实验室：一个关于学习率与动量的可玩实验，Loss Valley。">
  <PageHeader
    index="03"
    en="EXPERIMENTS / LAB"
    title="实验室"
    titleEn="EXPERIMENTS"
    description="把调参的直觉，变成一场可玩的实验。调整学习率与动量，观察参数球如何在损失地形里移动、停滞、越过局部最优，最后收敛。"
    meta={['EXPERIMENTS 01', 'STATUS / ONLINE', 'INPUT / MOUSE + KEYBOARD']}
  />

  <section class="section lab-page">
    <div class="container">
      <div class="lab-page__brief" data-reveal>
        <div>
          <span>01 / TUNE</span>
          <p>调学习率与动量</p>
        </div>
        <div>
          <span>02 / RUN</span>
          <p>观察参数更新过程</p>
        </div>
        <div>
          <span>03 / CONVERGE</span>
          <p>在步数耗尽前进入全局最优</p>
        </div>
        <p class="lab-page__brief-note">
          <span class="status-dot"></span>
          这不是在训练真实模型，但调参的快乐与痛苦是真的。
        </p>
      </div>

      <LossValley />

      <div class="lab-page__footer" data-reveal>
        <div>
          <p class="eyebrow">LAB NOTES / 001</p>
          <p>
            这个实验只做一件事：让你亲手感受 η 和 β 如何改变收敛路径。每一关的损失地形都是固定的，但你的策略不必相同。
          </p>
        </div>
        <div class="lab-page__next">
          <span>NEXT EXPERIMENT</span>
          <strong>QUEUED / 002</strong>
          <em>更多实验正在排队</em>
        </div>
      </div>

      <div class="lab-page__return">
        <a href={href('projects/')}>看看任务档案 <span>↗</span></a>
        <a href={href('writing/')}>读取观测记录 <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lab-page__brief {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(220px, 0.9fr);
    gap: 16px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }

  .lab-page__brief > div {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-right: 16px;
    border-right: 1px solid var(--line);
  }

  .lab-page__brief > div span {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.12em;
    opacity: 0.65;
  }

  .lab-page__brief > div p {
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: 12px;
    line-height: 1.7;
  }

  .lab-page__brief-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    align-self: end;
    color: var(--ink-faint);
    font-family: var(--font-cn);
    font-size: 10px;
    line-height: 1.8;
  }

  .lab-page__brief-note .status-dot {
    margin-top: 6px;
  }

  .lab-page__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    margin-top: 54px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .lab-page__footer > div:first-child {
    max-width: 56ch;
  }

  .lab-page__footer p:not(.eyebrow) {
    margin-top: 14px;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 12px;
    line-height: 1.95;
  }

  .lab-page__next {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 5px;
    min-width: 180px;
    padding: 16px;
    border: 1px dashed var(--line);
    opacity: 0.6;
  }

  .lab-page__next span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 6px;
    letter-spacing: 0.12em;
  }

  .lab-page__next strong {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .lab-page__next em {
    color: var(--ink-faint);
    font-family: var(--font-cn);
    font-size: 10px;
    font-style: normal;
  }

  .lab-page__return {
    display: flex;
    gap: 24px;
    margin-top: 42px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .lab-page__return a {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.08em;
    transition: color 0.3s ease;
  }

  .lab-page__return a span {
    color: var(--cyan);
  }

  .lab-page__return a:hover {
    color: var(--cyan);
  }

  @media (max-width: 1000px) {
    .lab-page__brief {
      grid-template-columns: 1fr 1fr;
    }

    .lab-page__brief > div:nth-child(2) {
      border-right: 0;
    }

    .lab-page__brief-note {
      grid-column: 1 / -1;
    }

    .lab-page__footer {
      flex-direction: column;
      gap: 24px;
    }
  }

  @media (max-width: 560px) {
    .lab-page__brief {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .lab-page__brief > div {
      padding-bottom: 10px;
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .lab-page__return {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
