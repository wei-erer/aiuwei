---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AiOrHuman from '../components/AiOrHuman.astro';
import TokenMatch from '../components/TokenMatch.astro';
import { href } from '../data/site';
---

<BaseLayout title="实验室" description="AIUWEI 实验室：两个中文小游戏，AI 真假判断与 Token 注意力配对。">
  <PageHeader
    index="03"
    en="PLAYGROUND / LAB"
    title="实验室"
    titleEn="EXPERIMENTS"
    description="两个不需要操作技巧的小游戏。一个判断文字背后是谁，一个寻找词语之间的注意力。规则都在开始页，中文说明。"
    meta={['GAMES 02', 'STATUS / OPEN', 'NO SIGN-UP / NO API']}
    stamp={`PLAY\n02`}
  />

  <section class="section lab-page">
    <div class="container">
      <div class="lab-note" data-reveal>
        <div>
          <p class="kicker">SELECT A GAME</p>
          <p>先选一个游戏。每个游戏都有自己的规则页和“开始”按钮，不会一上来就把你扔进计时器。</p>
        </div>
        <div class="lab-note__facts">
          <span>01 / 判断</span>
          <span>02 / 配对</span>
          <span>本地记录最佳成绩</span>
        </div>
      </div>

      <div class="lab-tabs" role="tablist" aria-label="选择游戏" data-reveal>
        <button class="lab-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="ai-or-human" id="tab-ai-or-human" data-lab-tab="ai-or-human">
          <span class="lab-tab__index">01</span>
          <span class="lab-tab__name">AI 真假判断</span>
          <span class="lab-tab__en">HUMAN OR AI?</span>
        </button>
        <button class="lab-tab" type="button" role="tab" aria-selected="false" aria-controls="token-match" id="tab-token-match" data-lab-tab="token-match">
          <span class="lab-tab__index">02</span>
          <span class="lab-tab__name">Token 注意力配对</span>
          <span class="lab-tab__en">ATTENTION MATCH</span>
        </button>
      </div>

      <div class="lab-panel" data-lab-panel="ai-or-human" id="ai-or-human" role="tabpanel" aria-labelledby="tab-ai-or-human">
        <AiOrHuman />
      </div>

      <div class="lab-panel" data-lab-panel="token-match" id="token-match" role="tabpanel" aria-labelledby="tab-token-match" hidden>
        <TokenMatch />
      </div>

      <div class="lab-foot" data-reveal>
        <p class="label">LAB NOTES / 两个游戏都可以反复玩</p>
        <p>游戏文本与词卡都是虚构的，用来观察表达、记忆和联想，不构成对真实模型或作者的判断。</p>
        <a class="link" href={href('writing/')}>回去读记录 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/lab-tabs.js';
</script>

<style>
  .lab-note {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--ink);
  }

  .lab-note > div:first-child {
    max-width: 64ch;
  }

  .lab-note > div:first-child p:not(.kicker) {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.9;
  }

  .lab-note__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 0 0 auto;
  }

  .lab-note__facts span {
    padding: 4px 8px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.03em;
  }

  .lab-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 28px;
  }

  .lab-tab {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 16px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
    text-align: left;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .lab-tab:hover {
    background: var(--acid);
  }

  .lab-tab.is-active {
    background: var(--ink);
    color: var(--paper-3);
  }

  .lab-tab__index {
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .lab-tab__name {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .lab-tab__en {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }

  .lab-panel {
    margin-top: 18px;
  }

  .lab-panel[hidden] {
    display: none !important;
  }

  .lab-foot {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) auto;
    align-items: start;
    gap: 20px;
    margin-top: 46px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }

  .lab-foot > p:nth-child(2) {
    max-width: 54ch;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .lab-foot .link {
    font-family: var(--font-mono);
    font-size: 10px;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .lab-note {
      align-items: flex-start;
      flex-direction: column;
    }

    .lab-tabs {
      grid-template-columns: 1fr;
    }

    .lab-foot {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  @media (max-width: 560px) {
    .lab-tab {
      grid-template-columns: 26px minmax(0, 1fr);
    }

    .lab-tab__en {
      display: none;
    }
  }
</style>
