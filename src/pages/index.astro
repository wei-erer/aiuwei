---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, href } from '../data/site';
import { getPosts, formatDate } from '../lib/content';
import { projects as allProjects } from '../content/projects';

const allPosts = getPosts();
const posts = allPosts.slice(0, 3);
const orderedProjects = [...allProjects]
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 3);
const postCount = String(allPosts.length).padStart(2, '0');
const projectCount = String(allProjects.length).padStart(2, '0');
---

<BaseLayout intro={true}>
  <section class="orbital-hero" aria-labelledby="hero-title" data-hero-parallax>
    <div class="orbital-hero__scene" aria-hidden="true">
      <div class="orbital-hero__stars"></div>
      <div class="orbital-hero__sun"></div>
      <div class="orbital-hero__planet"></div>
      <div class="orbital-hero__atmosphere"></div>
      <svg class="orbital-hero__station" viewBox="0 0 1400 760" fill="none">
        <defs>
          <linearGradient id="hero-metal" x1="180" y1="180" x2="1260" y2="620">
            <stop stop-color="#f5fdff" stop-opacity=".98" />
            <stop offset=".28" stop-color="#b7dce8" stop-opacity=".7" />
            <stop offset=".55" stop-color="#5e879d" stop-opacity=".4" />
            <stop offset=".8" stop-color="#315268" stop-opacity=".3" />
            <stop offset="1" stop-color="#d9f5ff" stop-opacity=".8" />
          </linearGradient>
          <linearGradient id="hero-cyan" x1="0" y1="0" x2="1" y2="0">
            <stop stop-color="#7bdcff" stop-opacity=".08" />
            <stop offset=".48" stop-color="#d8f8ff" stop-opacity=".9" />
            <stop offset="1" stop-color="#7bdcff" stop-opacity=".12" />
          </linearGradient>
          <radialGradient id="hero-hub" cx="50%" cy="50%" r="50%">
            <stop stop-color="#d9f9ff" stop-opacity=".5" />
            <stop offset=".34" stop-color="#7bdcff" stop-opacity=".2" />
            <stop offset="1" stop-color="#7bdcff" stop-opacity="0" />
          </radialGradient>
        </defs>

        <g transform="rotate(16 740 380)" opacity=".18">
          <ellipse cx="740" cy="380" rx="548" ry="156" stroke="url(#hero-metal)" stroke-width="1.2" />
          <ellipse cx="740" cy="380" rx="548" ry="156" stroke="url(#hero-cyan)" stroke-width="1" stroke-dasharray="2 18" />
        </g>

        <g transform="rotate(-12 740 380)">
          <ellipse cx="740" cy="380" rx="540" ry="150" stroke="url(#hero-metal)" stroke-width="2.6" />
          <ellipse cx="740" cy="380" rx="540" ry="150" stroke="url(#hero-cyan)" stroke-width="1.2" stroke-dasharray="1 10" opacity=".9" />
          <ellipse cx="740" cy="380" rx="460" ry="126" stroke="url(#hero-metal)" stroke-width="1.4" opacity=".7" />
          <ellipse cx="740" cy="380" rx="620" ry="174" stroke="url(#hero-metal)" stroke-width="1" opacity=".28" />

          <g stroke="rgba(192, 235, 252, .38)" stroke-width="1">
            <path d="M740 380V230M740 380V530M200 380H420M1060 380H1280" />
            <path d="M740 380L1122 486M740 380L358 274M740 380L1122 274M740 380L358 486" opacity=".55" />
          </g>

          <g fill="#dff8ff" opacity=".88">
            <rect x="732" y="214" width="16" height="32" rx="2" />
            <rect x="732" y="514" width="16" height="32" rx="2" />
            <rect x="1265" y="373" width="32" height="14" rx="2" />
            <rect x="183" y="373" width="32" height="14" rx="2" />
            <rect x="1108" y="480" width="28" height="12" rx="2" transform="rotate(28 1122 486)" />
            <rect x="346" y="268" width="28" height="12" rx="2" transform="rotate(28 360 274)" />
            <rect x="1108" y="268" width="28" height="12" rx="2" transform="rotate(-28 1122 274)" />
            <rect x="346" y="480" width="28" height="12" rx="2" transform="rotate(-28 360 486)" />
          </g>

          <g fill="#9feaff">
            <circle cx="740" cy="230" r="2.4" />
            <circle cx="740" cy="530" r="2.4" />
            <circle cx="1280" cy="380" r="2.4" />
            <circle cx="200" cy="380" r="2.4" />
            <circle cx="1122" cy="486" r="2" opacity=".8" />
            <circle cx="358" cy="274" r="2" opacity=".8" />
            <circle cx="1122" cy="274" r="2" opacity=".8" />
            <circle cx="358" cy="486" r="2" opacity=".8" />
            <circle cx="1010" cy="440" r="1.6" opacity=".6" />
            <circle cx="470" cy="320" r="1.6" opacity=".6" />
          </g>

          <g opacity=".75">
            <rect x="466" y="242" width="56" height="22" rx="1" fill="#071b2a" stroke="rgba(201,242,255,.55)" stroke-width=".8" transform="rotate(-24 494 253)" />
            <path d="M472 246l44 16M478 240l44 16M484 234l44 16" stroke="rgba(158,226,250,.32)" stroke-width=".7" transform="rotate(-24 494 253)" />
          </g>

          <circle cx="740" cy="380" r="86" stroke="#9feaff" stroke-width="1" opacity=".18" />
          <circle cx="740" cy="380" r="52" stroke="url(#hero-metal)" stroke-width="1.2" opacity=".7" />
          <circle cx="740" cy="380" r="44" fill="url(#hero-hub)" />
          <circle cx="740" cy="380" r="20" fill="#061421" stroke="url(#hero-metal)" stroke-width="1.6" />
          <circle cx="740" cy="380" r="5" fill="#b9f3ff" />
          <path d="M740 360v-42M740 400v42" stroke="rgba(210,246,255,.6)" stroke-width="1" />
          <path d="M720 380h-34M760 380h34" stroke="rgba(210,246,255,.35)" stroke-width="1" />
        </g>
      </svg>
      <div class="orbital-hero__grid" aria-hidden="true"></div>
    </div>
    <div class="orbital-hero__shade" aria-hidden="true"></div>
    <div class="orbital-hero__cursor" data-hero-cursor aria-hidden="true"></div>

    <div class="orbital-hero__inner container">
      <div class="orbital-hero__top" data-hero>
        <span class="label">AIUWEI / DEEP SPACE OBSERVATORY</span>
        <span class="label">ORBITAL DECK 07 / {site.established}</span>
      </div>

      <div class="orbital-hero__main">
        <div class="orbital-hero__copy">
          <p class="kicker" data-hero style="--delay: 0.04s">FIRST LIGHT / SIGNAL LOCKED</p>
          <h1 class="orbital-hero__title" id="hero-title" data-hero style="--delay: 0.1s">
            <span class="orbital-hero__en">AIUWEI</span>
            <span class="orbital-hero__cn">在深空里，<br /><em>记录智能的微光。</em></span>
          </h1>
          <p class="orbital-hero__lede" data-hero style="--delay: 0.16s">
            我是 wei_er。这里是 AIUWEI，一座轨道上的个人观测站。
            记录 LLM、Agent 与 AI 安全方向的实验、判断，还有没想清楚但值得留下的问题。
          </p>
          <div class="orbital-hero__actions" data-hero style="--delay: 0.22s">
            <a class="btn btn--solid" href="#logs"><span>进入观测站</span><span class="btn__arrow" aria-hidden="true">↓</span></a>
            <a class="link" href={href('about/')}>关于记录者 ↗</a>
            <button class="orbital-hero__console" type="button" data-console-open>
              观测终端 <span class="console-key">Ctrl K</span>
            </button>
          </div>
        </div>

        <aside class="orbital-hero__crew" data-hero style="--delay: 0.18s" aria-label="记录者信息">
          <img src={href('images/avatar.jpg')} alt="wei_er 的插画头像" width="640" height="640" />
          <div>
            <span class="label">记录者 / CREW</span>
            <strong>WEI_ER</strong>
            <p>LLM / AGENT / ALIGNMENT</p>
          </div>
        </aside>
      </div>

      <div class="orbital-hero__foot" data-hero style="--delay: 0.3s">
        <span class="label">SCROLL / 向下进入观测舱</span>
        <span class="label">DEEP SPACE / 2026</span>
      </div>
    </div>
  </section>

  <section class="station-section" id="logs">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">01 / 观测记录</span>
        <span class="section-label__meta">记录 / {postCount}</span>
      </div>
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">OBSERVATION LOGS</p>
          <h2>观测记录</h2>
        </div>
        <a class="link" href={href('writing/')}>全部记录 ↗</a>
      </div>

      {posts.length > 0 ? (
        <div class="log-list">
          {posts.map((post, index) => (
            <a class="log-row" href={href(`writing/${post.slug}/`)} data-reveal>
              <span class="log-row__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="log-row__body">
                <span class="log-row__meta">{formatDate(post.data.pubDate)} / {post.data.tags.slice(0, 2).join(' / ') || 'NOTE'}</span>
                <strong>{post.data.title}</strong>
                {post.data.description && <span class="log-row__desc">{post.data.description}</span>}
              </span>
              <span class="log-row__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-log" data-reveal>
          <div class="empty-log__number">000</div>
          <div class="empty-log__copy">
            <p class="kicker">NO TRANSMISSION YET</p>
            <h3>还没有记录。</h3>
            <p>
              等第一篇文章写完，它会出现在这里。不用占位内容凑数，也不假装这里已经有人读过。
            </p>
            <a class="link" href={href('writing/')}>打开记录页 ↗</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="station-section station-section--manifest" id="missions">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">02 / 项目档案</span>
        <span class="section-label__meta">档案 / {projectCount}</span>
      </div>
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">MISSION ARCHIVE</p>
          <h2>项目档案</h2>
        </div>
        <a class="link" href={href('projects/')}>全部项目 ↗</a>
      </div>

      {orderedProjects.length > 0 ? (
        <div class="manifest">
          {orderedProjects.map((project, index) => (
            <article class="manifest-row" data-reveal>
              <span class="manifest-row__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="manifest-row__body">
                <div class="manifest-row__top">
                  <h3>{project.title}</h3>
                  <span class="tag">{project.status}</span>
                </div>
                <p>{project.description}</p>
                <div class="manifest-row__meta">
                  <span>{project.year}</span>
                  {project.stack.slice(0, 3).map((item) => <span>{item}</span>)}
                  {project.repo && <a href={project.repo} target="_blank" rel="noreferrer">REPO ↗</a>}
                  {project.link && <a href={project.link} target="_blank" rel="noreferrer">OPEN ↗</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-manifest" data-reveal>
          <div class="empty-manifest__line"><span>001</span><span>—</span><span>未归档</span></div>
          <div class="empty-manifest__line"><span>002</span><span>—</span><span>未归档</span></div>
          <div class="empty-manifest__line"><span>003</span><span>—</span><span>未归档</span></div>
          <div class="empty-manifest__copy">
            <p class="kicker">STANDBY / NO VERIFIED FILE</p>
            <h3>只归档能说清<br />问题、方法和结果。</h3>
            <p>第一份可验证的档案还在准备中。没有链接、没有实验条件的项目，不会出现在这里。</p>
            <a class="link" href={href('projects/')}>查看项目页 ↗</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="station-section" id="observer">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">03 / 记录者</span>
        <span class="section-label__meta">WEI_ER / HUMAN</span>
      </div>
      <div class="home-about" data-reveal>
        <figure class="home-about__portrait">
          <img src={href('images/avatar.jpg')} alt="wei_er 的插画头像" width="640" height="640" />
          <figcaption><span>OBSERVER / 001</span><span>WEI_ER</span></figcaption>
        </figure>
        <div class="home-about__copy">
          <p class="kicker">THE OBSERVER</p>
          <h2>我是 wei_er，<br /><em>在轨道上观测的人。</em></h2>
          <p>
            AIUWEI 不是一家公司，也不是一个产品。它是我面对智能时使用的另一个身份，
            一座持续建设中的个人观测站。
          </p>
          <p>
            我更喜欢把“做 AI”理解成一种观测：提出假设，搭一个足够小的实验，
            记录它如何失败，再决定下一步。
          </p>
          <div class="home-about__foot">
            <span class="label">FOCUS / LLM · AGENT · ALIGNMENT</span>
            <a class="link" href={href('about/')}>完整档案 ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="closing__scene" aria-hidden="true"></div>
    <div class="container closing__inner" data-reveal>
      <p class="kicker">SIGNAL OPEN / 2026</p>
      <h2>先记录，<br /><em>再命名。</em></h2>
      <div class="closing__links">
        <a class="link" href={href('writing/')}>观测记录 ↗</a>
        <a class="link" href={href('projects/')}>项目档案 ↗</a>
        <a class="link" href={href('about/')}>关于记录者 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .orbital-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #02060d;
    --mx: 0;
    --my: 0;
  }

  .orbital-hero__stars,
  .orbital-hero__planet,
  .orbital-hero__atmosphere,
  .orbital-hero__station {
    translate: calc(var(--mx, 0) * 14px) calc(var(--my, 0) * 10px);
    transition: translate 0.65s var(--ease);
    will-change: translate;
  }

  .orbital-hero__cursor {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 220, 255, 0.12), rgba(123, 220, 255, 0.035) 35%, transparent 68%);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: opacity 0.35s ease;
  }

  .orbital-hero.is-pointer .orbital-hero__cursor {
    opacity: 1;
  }

  .orbital-hero__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .orbital-hero__stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(224, 246, 255, 0.8) 0.8px, transparent 0.8px),
      radial-gradient(rgba(150, 215, 245, 0.55) 0.6px, transparent 0.6px);
    background-size: 67px 59px, 127px 101px;
    background-position: 17px 11px, 43px 37px;
    opacity: 0.55;
  }

  .orbital-hero__sun {
    position: absolute;
    left: -260px;
    top: -420px;
    width: 1000px;
    height: 1000px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(210, 246, 255, 0.22), rgba(92, 180, 225, 0.08) 36%, transparent 68%);
    filter: blur(2px);
  }

  .orbital-hero__planet {
    position: absolute;
    right: -360px;
    bottom: -980px;
    width: 1600px;
    height: 1600px;
    border-radius: 50%;
    background:
      radial-gradient(ellipse 18% 5% at 61% 42%, rgba(231, 252, 255, 0.18), rgba(10, 45, 68, 0.2) 46%, transparent 72%),
      radial-gradient(ellipse 42% 11% at 37% 57%, rgba(0, 7, 14, 0.22), transparent 72%),
      radial-gradient(
        circle at 30% 22%,
        #e8fcff 0,
        #b4f0ff 4%,
        #4aa9d2 12%,
        #135a80 27%,
        #06283f 50%,
        #010a12 73%,
        #000204 90%
      );
    box-shadow: 0 0 100px rgba(95, 195, 240, 0.12);
    animation: planet-drift 26s ease-in-out infinite alternate;
  }

  .orbital-hero__planet::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 7% 3% at 60% 46%, rgba(225, 250, 255, 0.3), rgba(3, 25, 42, 0.28) 48%, transparent 72%),
      repeating-linear-gradient(
        9deg,
        transparent 0 24px,
        rgba(208, 246, 255, 0.075) 25px 29px,
        transparent 30px 68px
      ),
      repeating-linear-gradient(
        4deg,
        transparent 0 48px,
        rgba(2, 18, 32, 0.14) 49px 58px,
        transparent 59px 112px
      );
    mix-blend-mode: screen;
    opacity: 0.9;
    pointer-events: none;
  }

  .orbital-hero__planet::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      116deg,
      transparent 6%,
      rgba(0, 4, 10, 0.14) 40%,
      rgba(0, 2, 7, 0.58) 76%,
      rgba(0, 1, 4, 0.9) 100%
    );
    pointer-events: none;
  }

  .orbital-hero__atmosphere {
    position: absolute;
    right: -390px;
    bottom: -950px;
    width: 1650px;
    height: 1650px;
    border-radius: 50%;
    border: 1px solid rgba(177, 235, 255, 0.45);
    box-shadow: 0 0 55px rgba(110, 210, 255, 0.14);
    animation: planet-drift 26s ease-in-out infinite alternate;
  }

  .orbital-hero__station {
    position: absolute;
    right: -180px;
    top: 8%;
    width: min(1400px, 90vw);
    opacity: 0.66;
    filter: drop-shadow(0 0 18px rgba(95, 195, 240, 0.1));
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.2) 18%, #000 42%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.2) 18%, #000 42%);
    animation: station-drift 18s ease-in-out infinite alternate;
  }

  .orbital-hero__grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(120, 200, 235, 0.035) 1px, transparent 1px),
      linear-gradient(rgba(120, 200, 235, 0.025) 1px, transparent 1px);
    background-size: 120px 120px;
    mask-image: radial-gradient(ellipse at 68% 45%, #000 0, transparent 68%);
    opacity: 0.5;
  }

  .orbital-hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(2, 6, 13, 0.95) 0%, rgba(2, 6, 13, 0.72) 34%, rgba(2, 6, 13, 0.15) 68%, rgba(2, 6, 13, 0.42) 100%),
      linear-gradient(to bottom, rgba(2, 6, 13, 0.55) 0%, transparent 24%, transparent 64%, rgba(2, 6, 13, 0.92) 100%);
  }

  .orbital-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + 24px);
    padding-bottom: 24px;
  }

  .orbital-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .orbital-hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(30px, 5vw, 80px);
    align-items: end;
    margin-top: auto;
    padding-block: clamp(50px, 8vh, 110px);
  }

  .orbital-hero__copy {
    max-width: 800px;
  }

  .orbital-hero__title {
    margin-top: 20px;
  }

  .orbital-hero__en {
    display: block;
    color: var(--ice);
    font-size: clamp(72px, 8vw, 118px);
    font-weight: 300;
    letter-spacing: 0.1em;
    line-height: 0.82;
  }

  .orbital-hero__cn {
    display: block;
    margin-top: 24px;
    color: var(--text);
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 300;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .orbital-hero__cn em {
    font-style: normal;
    color: var(--ice);
    border-bottom: 1px solid var(--cyan);
  }

  .orbital-hero__lede {
    max-width: 37em;
    margin-top: 24px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.9;
  }

  .orbital-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
    margin-top: 28px;
  }

  .orbital-hero__console {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
  }

  .orbital-hero__console:hover {
    color: var(--cyan);
  }

  .console-key {
    padding: 2px 5px;
    border: 1px solid var(--line);
    color: var(--faint);
    font-size: 9px;
    line-height: 1.2;
  }

  .orbital-hero__crew {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 8px;
  }

  .orbital-hero__crew img {
    width: 76px;
    height: 76px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .orbital-hero__crew div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .orbital-hero__crew strong {
    color: var(--ice);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.14em;
  }

  .orbital-hero__crew p {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
