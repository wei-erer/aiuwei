---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NeuralCore from '../components/NeuralCore.astro';
import AvatarFrame from '../components/AvatarFrame.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, href, emptyCopy } from '../data/site';
import { getPosts } from '../lib/content';
import { projects as allProjects } from '../content/projects';

const allPosts = getPosts();
const posts = allPosts.slice(0, 3);

const projects = [...allProjects]
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 3);

const postCount = String(allPosts.length).padStart(2, '0');
const projectCount = String(allProjects.length).padStart(2, '0');
---

<BaseLayout intro={true}>
  <section class="hero">
    <div class="hero__grid" aria-hidden="true"></div>

    <div class="hero__inner container">
      <div class="hero__content">
        <p class="hero__eyebrow" data-hero style="--delay: 0.04s">
          <span class="status-dot"></span>
          <span>DEEP SPACE AI OBSERVATORY</span>
          <span class="hero__eyebrow-line" aria-hidden="true"></span>
          <span>EST. {site.established}</span>
        </p>

        <h1 class="hero__title" data-hero style="--delay: 0.12s">
          <span class="hero__title-main" data-text="AIUWEI">AIUWEI</span>
          <span class="hero__title-cn">在深空里，<br /><em>记录智能的微光。</em></span>
        </h1>

        <p class="hero__lede" data-hero style="--delay: 0.22s">
          我是 wei_er。这里是我的 AI 观测站，记录 LLM、Agent、RAG 与 AI
          安全方向的实验、项目与思考。
        </p>

        <ul class="hero__focus" data-hero style="--delay: 0.3s" aria-label="关注方向">
          {site.focus.map((item) => <li>{item}</li>)}
          <li>BUILDING IN PUBLIC</li>
        </ul>

        <div class="hero__actions" data-hero style="--delay: 0.38s">
          <a class="btn btn--primary" href="#signals">
            <span class="btn__code">01</span>
            <span>读取观测记录</span>
            <span class="btn__arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn btn--ghost" href={href('lab/')}>
            <span class="btn__code">LAB</span>
            <span>进入实验室</span>
            <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero__visual" data-hero style="--delay: 0.18s">
        <div class="hero__ring" aria-hidden="true"></div>
        <div class="hero__ring hero__ring--inner" aria-hidden="true"></div>
        <div class="hero__crosshair" aria-hidden="true">
          <span class="hero__crosshair-h"></span>
          <span class="hero__crosshair-v"></span>
        </div>

        <NeuralCore nodes={142} />

        <div class="hero__hud hero__hud--tl" aria-hidden="true">
          <span>NEURAL CORE</span>
          <strong>00 / AIUWEI</strong>
        </div>
        <div class="hero__hud hero__hud--tr" aria-hidden="true">
          <span>CORE SYNC</span>
          <strong>98.2%</strong>
        </div>
        <div class="hero__hud hero__hud--bl" aria-hidden="true">
          <span>SIGNAL</span>
          <strong>LOCKED</strong>
        </div>
        <div class="hero__hud hero__hud--br" aria-hidden="true">
          <span>OBSERVER</span>
          <strong>WEI_ER</strong>
        </div>

        <p class="hero__core-hint">MOVE CURSOR <span>//</span> 让核心感知你</p>
      </div>
    </div>

    <div class="hero__status container" data-hero style="--delay: 0.5s">
      <a class="hero__scroll" href="#signals">
        <span class="hero__scroll-line" aria-hidden="true"></span>
        <span>SCROLL TO EXPLORE</span>
      </a>
      <div class="hero__status-list" aria-label="站点状态">
        <span><i class="status-dot"></i> CORE: ONLINE</span>
        <span>ARCHIVE: {postCount}</span>
        <span>MISSIONS: {projectCount}</span>
        <span>LAB: 01</span>
      </div>
    </div>
  </section>

  <section class="section signals" id="signals">
    <div class="container">
      <SectionHeading
        index="01"
        en="LATEST TRANSMISSIONS"
        title="观测记录"
        link={href('writing/')}
        linkLabel="全部记录"
      />

      <div class="signals__grid">
        <div class="signal-manifesto" data-reveal>
          <p class="eyebrow">OBSERVATION PROTOCOL / 001</p>
          <p class="signal-manifesto__quote">先记录，<br /><em>再命名。</em></p>
          <p class="signal-manifesto__body">
            AIUWEI 不是一份简历，也不是一个产品。它是一座持续建设中的个人观测站：把读过的论文、跑过的实验、做过的项目，以及那些还没想清楚的问题，留在深空里。
          </p>

          <ul class="signal-manifesto__list">
            <li>
              <span class="signal-manifesto__num">01</span>
              <span class="signal-manifesto__item"><strong>实验记录</strong><em>EXPERIMENTS</em></span>
              <span aria-hidden="true">→</span>
            </li>
            <li>
              <span class="signal-manifesto__num">02</span>
              <span class="signal-manifesto__item"><strong>项目档案</strong><em>MISSION FILES</em></span>
              <span aria-hidden="true">→</span>
            </li>
            <li>
              <span class="signal-manifesto__num">03</span>
              <span class="signal-manifesto__item"><strong>长文与碎片</strong><em>TRANSMISSIONS</em></span>
              <span aria-hidden="true">→</span>
            </li>
          </ul>

          <p class="signal-manifesto__note">
            <span class="status-dot status-dot--amber"></span>
            STATION NOTE // 记录正在陆续上传
          </p>
        </div>

        <div class="signals__feed" data-reveal style="--delay: 0.1s">
          {posts.length > 0 ? (
            <div class="signal-list">
              <div class="signal-list__head">
                <span>LATEST FEED</span>
                <span>{postCount} LOGS</span>
              </div>
              {posts.map((post, index) => <PostRow post={post} index={index} />)}
            </div>
          ) : (
            <div class="empty-feed panel">
              <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>

              <div class="empty-feed__top">
                <span><i class="status-dot status-dot--amber"></i> LIVE FEED // NO SIGNAL</span>
                <span>CH 001</span>
              </div>

              <div class="empty-feed__body">
                <span class="empty-feed__count" aria-hidden="true">00</span>
                <div>
                  <h3>{emptyCopy.posts.title}</h3>
                  <p>{emptyCopy.posts.body}</p>
                </div>
              </div>

              <div class="terminal empty-feed__terminal">
                <span>{emptyCopy.posts.prompt}</span><span class="caret" aria-hidden="true"></span>
              </div>

              <div class="empty-feed__foot">
                <span>CHANNEL OPEN</span>
                <span>AWAITING WEI_ER</span>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section projects" id="projects">
    <div class="container">
      <SectionHeading
        index="02"
        en="MISSION FILES"
        title="项目档案"
        link={href('projects/')}
        linkLabel="全部任务"
      />

      {projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <div class="mission-layout">
          <div class="mission-slots" data-reveal>
            {[1, 2, 3].map((slot) => (
              <div class="mission-slot">
                <span class="mission-slot__top">SLOT {String(slot).padStart(2, '0')}</span>
                <span class="mission-slot__plus" aria-hidden="true">+</span>
                <span class="mission-slot__bottom"><span>STATUS</span><strong>OPEN</strong></span>
              </div>
            ))}
          </div>

          <div class="mission-note panel" data-reveal style="--delay: 0.12s">
            <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
            <div>
              <p class="eyebrow">MISSION CONTROL / STANDBY</p>
              <h3>第一份任务档案，<br />还在深空里。</h3>
              <p>
                这里会放置实验、工具与独立项目。每个项目都会带上技术栈、状态和可验证的链接。
              </p>
            </div>
            <div class="terminal mission-note__terminal">
              <span>wei_er@aiuwei:~$ ls /missions --all</span><span class="caret" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section lab" id="lab">
    <div class="container">
      <SectionHeading
        index="03"
        en="EXPERIMENTS"
        title="实验室"
        link={href('lab/')}
        linkLabel="进入 Lab"
      />

      <a class="lab-feature panel" href={href('lab/')} data-reveal>
        <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>

        <div class="lab-feature__visual" aria-hidden="true">
          <span class="lab-feature__badge">PLAYABLE // 01</span>
          <svg viewBox="0 0 600 280" role="presentation">
            <defs>
              <linearGradient id="loss-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#64f4df" stop-opacity="0.18" />
                <stop offset="1" stop-color="#64f4df" stop-opacity="0" />
              </linearGradient>
              <filter id="loss-glow" x="-20%" y="-40%" width="140%" height="180%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>
            <g class="lab-feature__grid">
              <path d="M40 40H560M40 90H560M40 140H560M40 190H560M40 240H560" />
              <path d="M40 30V250M140 30V250M240 30V250M340 30V250M440 30V250M540 30V250" />
            </g>
            <path
              class="lab-feature__curve"
              d="M40 62 C86 124 118 166 164 160 C210 154 228 92 268 100 C310 108 326 198 382 204 C430 209 458 168 500 174 C522 177 544 184 560 190"
            />
            <path
              class="lab-feature__fill"
              d="M40 62 C86 124 118 166 164 160 C210 154 228 92 268 100 C310 108 326 198 382 204 C430 209 458 168 500 174 C522 177 544 184 560 190 L560 250 L40 250 Z"
            />
            <line class="lab-feature__target-line" x1="500" y1="40" x2="500" y2="250" />
            <circle class="lab-feature__target" cx="500" cy="174" r="12" />
            <circle class="lab-feature__target-dot" cx="500" cy="174" r="3" />
            <circle class="lab-feature__ball" cx="164" cy="160" r="7" />
            <text x="40" y="24" class="lab-feature__label">LOSS</text>
            <text x="458" y="130" class="lab-feature__label">GLOBAL MIN</text>
            <text x="132" y="214" class="lab-feature__label">LOCAL MIN</text>
          </svg>
          <div class="lab-feature__readout">
            <span>η 0.082</span>
            <span>β 0.913</span>
            <span>LOSS 0.041</span>
          </div>
        </div>

        <div class="lab-feature__copy">
          <p class="eyebrow">EXPERIMENT 001 / OPTIMIZATION</p>
          <h3>LOSS<br />VALLEY</h3>
          <p class="lab-feature__cn">收敛协议</p>
          <p class="lab-feature__desc">
            调整学习率与动量，让参数球穿过局部最优，收敛到全局最低点。三关，一次关于调参直觉的实验。
          </p>
          <div class="lab-feature__meta">
            <span>3 LEVELS</span>
            <span>60–90 SEC</span>
            <span>TOUCH READY</span>
          </div>
          <span class="lab-feature__cta">启动实验 <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </div>
  </section>

  <section class="section about" id="about">
    <div class="container">
      <SectionHeading
        index="04"
        en="THE OBSERVER"
        title="记录者"
        link={href('about/')}
        linkLabel="关于 wei_er"
      />

      <div class="about__grid">
        <AvatarFrame compact />

        <div class="about__copy" data-reveal style="--delay: 0.1s">
          <p class="eyebrow">CALLSIGN / WEI_ER</p>
          <h2 class="about__title">在 AI 深空里，<br /><em>持续观测的人。</em></h2>
          <p class="about__body">
            我是 wei_er，一个关注 LLM、Agent、RAG 与 AI 安全/对齐的独立记录者。AIUWEI
            是我的 AI 身份，也是这座观测站的名字。这里没有标准答案，只有持续更新的观测记录。
          </p>

          <div class="about__identity">
            <div><span>CALLSIGN</span><strong>WEI_ER</strong></div>
            <div><span>AI ALIAS</span><strong>AIUWEI</strong></div>
            <div><span>FOCUS</span><strong>LLM / AGENT / ALIGNMENT</strong></div>
            <div><span>STATUS</span><strong><i class="status-dot"></i> OBSERVING</strong></div>
          </div>

          <div class="about__actions">
            <a class="btn btn--ghost" href={href('about/')}>
              <span>完整档案</span>
              <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="about__github" href={site.github} target="_blank" rel="noreferrer">
              <span>GITHUB</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================
     Hero
     ========================================================= */

  .hero {
    position: relative;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    overflow: hidden;
    padding-top: var(--nav-h);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.34;
    background-image:
      linear-gradient(to right, rgba(100, 244, 223, 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(100, 244, 223, 0.045) 1px, transparent 1px);
    background-size: 118px 118px;
    mask-image: radial-gradient(ellipse 72% 70% at 62% 48%, black 0%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 72% 70% at 62% 48%, black 0%, transparent 78%);
    pointer-events: none;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 4%;
    right: -12vw;
    width: 62vw;
    height: 62vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(46, 196, 182, 0.09), transparent 64%);
    filter: blur(16px);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1.02fr) minmax(300px, 0.98fr);
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding-block: clamp(44px, 7vh, 90px);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__eyebrow-line {
    display: inline-block;
    width: 34px;
    height: 1px;
    background: var(--line-strong);
  }

  .hero__title {
    margin-top: clamp(26px, 4vh, 44px);
    font-weight: 400;
  }

  .hero__title-main {
    position: relative;
    display: block;
    width: fit-content;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(76px, 12.4vw, 178px);
    font-weight: 400;
    letter-spacing: 0.012em;
    line-height: 0.78;
    text-shadow: 0 0 90px rgba(100, 244, 223, 0.07);
  }

  .hero__title-main::before,
  .hero__title-main::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--cyan);
    opacity: 0;
    pointer-events: none;
  }

  .hero__title-main::before {
    clip-path: inset(0 0 54% 0);
  }

  .hero__title-main::after {
    clip-path: inset(56% 0 0 0);
    color: var(--blue);
  }

  .hero__title-main:hover::before {
    opacity: 0.28;
    transform: translate(3px, -1px);
  }

  .hero__title-main:hover::after {
    opacity: 0.18;
    transform: translate(-3px, 1px);
  }

  .hero__title-cn {
    display: block;
    margin-top: clamp(24px, 4vh, 38px);
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: clamp(22px, 3vw, 40px);
    font-weight: 300;
    letter-spacing: 0.01em;
    line-height: 1.42;
  }

  .hero__title-cn em {
    background: linear-gradient(100deg, var(--ink) 8%, var(--cyan) 65%, var(--blue) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    max-width: 52ch;
    margin-top: clamp(20px, 3vh, 30px);
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 14px;
    letter-spacing: 0.02em;
    line-height: 1.95;
  }

  .hero__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 22px;
  }

  .hero__focus li {
    padding: 5px 8px;
    border: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(28px, 4vh, 38px);
  }

  .hero__visual {
    position: relative;
    z-index: 1;
    width: min(100%, 580px);
    aspect-ratio: 1;
    justify-self: end;
  }

  .hero__ring {
    position: absolute;
    inset: -1%;
    border: 1px dashed rgba(100, 244, 223, 0.15);
    border-radius: 50%;
    animation: hero-ring 70s linear infinite;
    pointer-events: none;
  }

  .hero__ring--inner {
    inset: 8%;
    border-style: solid;
    border-color: rgba(109, 140, 255, 0.12);
    border-left-color: rgba(100, 244, 223, 0.24);
    animation-duration: 46s;
    animation-direction: reverse;
  }

  .hero__ring::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 12px rgba(100, 244, 223, 0.8);
  }

  @keyframes hero-ring {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__crosshair {
    position: absolute;
    inset: 3%;
    z-index: 3;
    pointer-events: none;
  }

  .hero__crosshair-h,
  .hero__crosshair-v {
    position: absolute;
    background: linear-gradient(to right, transparent, rgba(100, 244, 223, 0.12), transparent);
  }

  .hero__crosshair-h {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
  }

  .hero__crosshair-v {
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(to bottom, transparent, rgba(100, 244, 223, 0.1), transparent);
  }

  .hero__visual .neural-core {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__hud {
    position: absolute;
    z-index: 4;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.16em;
    line-height: 1.8;
    text-transform: uppercase;
    pointer-events: none;
  }

  .hero__hud span {
    display: block;
  }

  .hero__hud strong {
    display: block;
    color: var(--cyan);
    font-size: 8px;
    font-weight: 400;
    letter-spacing: 0.12em;
    opacity: 0.75;
  }

  .hero__hud--tl {
    top: 5%;
    left: 1%;
  }

  .hero__hud--tr {
    top: 5%;
    right: 1%;
    text-align: right;
  }

  .hero__hud--bl {
    bottom: 5%;
    left: 1%;
  }

  .hero__hud--br {
    bottom: 5%;
    right: 1%;
    text-align: right;
  }

  .hero__core-hint {
    position: absolute;
    bottom: -2%;
    left: 50%;
    z-index: 4;
    width: max-content;
    transform: translateX(-50%);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-align: center;
    opacity: 0.65;
    pointer-events: none;
  }

  .hero__core-hint span {
    color: var(--cyan);
  }

  .hero__status {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 14px;
    padding-bottom: 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-muted);
    transition: color 0.3s ease;
  }

  .hero__scroll:hover {
    color: var(--cyan);
  }

  .hero__scroll-line {
    position: relative;
    display: block;
    width: 54px;
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 26px;
    height: 1px;
    background: var(--cyan);
    animation: scroll-line 2.4s ease-in-out infinite;
  }

  @keyframes scroll-line {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(220%);
    }
  }

  .hero__status-list {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

