---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, href } from '../data/site';
import { getPosts, formatDate } from '../lib/content';
import { projects as allProjects } from '../content/projects';

const allPosts = getPosts();
const posts = allPosts.slice(0, 3);
const orderedProjects = [...allProjects]
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 3);
const postCount = String(allPosts.length).padStart(2, '0');
const projectCount = String(allProjects.length).padStart(2, '0');
---

<BaseLayout intro={true}>
  <section class="orbital-hero" aria-labelledby="hero-title">
    <div class="orbital-hero__scene" aria-hidden="true">
      <div class="orbital-hero__stars"></div>
      <div class="orbital-hero__sun"></div>
      <div class="orbital-hero__planet"></div>
      <div class="orbital-hero__atmosphere"></div>
      <svg class="orbital-hero__station" viewBox="0 0 1200 640" fill="none">
        <defs>
          <linearGradient id="hero-metal" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#eafaff" stop-opacity=".9" />
            <stop offset=".45" stop-color="#7fa4b8" stop-opacity=".42" />
            <stop offset="1" stop-color="#2a4558" stop-opacity=".14" />
          </linearGradient>
          <linearGradient id="hero-cyan" x1="0" y1="0" x2="1" y2="0">
            <stop stop-color="#7bdcff" stop-opacity=".15" />
            <stop offset=".5" stop-color="#c9f5ff" stop-opacity=".8" />
            <stop offset="1" stop-color="#7bdcff" stop-opacity=".1" />
          </linearGradient>
        </defs>
        <ellipse cx="760" cy="300" rx="510" ry="138" transform="rotate(-12 760 300)" stroke="url(#hero-metal)" stroke-width="1.8" opacity=".95" />
        <ellipse cx="760" cy="300" rx="510" ry="138" transform="rotate(-12 760 300)" stroke="url(#hero-cyan)" stroke-width="1.2" stroke-dasharray="1 9" opacity=".9" />
        <ellipse cx="760" cy="300" rx="410" ry="108" transform="rotate(-12 760 300)" stroke="url(#hero-metal)" stroke-width="1.2" opacity=".65" />
        <ellipse cx="760" cy="300" rx="580" ry="158" transform="rotate(-12 760 300)" stroke="url(#hero-metal)" stroke-width="1" opacity=".32" />
        <path d="M250 300h246M1020 300h104" stroke="url(#hero-cyan)" stroke-width="1.2" opacity=".55" />
        <circle cx="760" cy="300" r="42" stroke="#9feaff" stroke-width="1" opacity=".32" />
        <circle cx="760" cy="300" r="72" stroke="#9feaff" stroke-width="1" opacity=".16" />
        <g fill="#dff8ff" opacity=".85">
          <rect x="438" y="288" width="34" height="16" rx="2" />
          <rect x="1010" y="294" width="38" height="14" rx="2" />
          <rect x="748" y="210" width="16" height="34" rx="2" />
          <rect x="748" y="356" width="16" height="34" rx="2" />
          <rect x="620" y="244" width="26" height="10" rx="2" opacity=".7" />
          <rect x="874" y="342" width="26" height="10" rx="2" opacity=".7" />
        </g>
        <circle cx="760" cy="300" r="22" fill="#061421" stroke="url(#hero-metal)" stroke-width="1.4" />
        <circle cx="760" cy="300" r="5" fill="#a9efff" />
      </svg>
      <div class="orbital-hero__grid" aria-hidden="true"></div>
    </div>
    <div class="orbital-hero__shade" aria-hidden="true"></div>

    <div class="orbital-hero__inner container">
      <div class="orbital-hero__top" data-hero>
        <span class="label">AIUWEI / DEEP SPACE OBSERVATORY</span>
        <span class="label">ORBITAL DECK 07 / {site.established}</span>
      </div>

      <div class="orbital-hero__main">
        <div class="orbital-hero__copy">
          <p class="kicker" data-hero style="--delay: 0.04s">FIRST LIGHT / SIGNAL LOCKED</p>
          <h1 class="orbital-hero__title" id="hero-title" data-hero style="--delay: 0.1s">
            <span class="orbital-hero__en">AIUWEI</span>
            <span class="orbital-hero__cn">在深空里，<br /><em>记录智能的微光。</em></span>
          </h1>
          <p class="orbital-hero__lede" data-hero style="--delay: 0.16s">
            我是 wei_er。这里是 AIUWEI，一座轨道上的个人观测站。
            记录 LLM、Agent 与 AI 安全方向的实验、判断，还有没想清楚但值得留下的问题。
          </p>
          <div class="orbital-hero__actions" data-hero style="--delay: 0.22s">
            <a class="btn btn--solid" href="#logs"><span>进入观测站</span><span class="btn__arrow" aria-hidden="true">↓</span></a>
            <a class="link" href={href('about/')}>关于记录者 ↗</a>
          </div>
        </div>

        <aside class="orbital-hero__crew" data-hero style="--delay: 0.18s" aria-label="记录者信息">
          <img src={href('images/avatar.jpg')} alt="wei_er 的插画头像" width="640" height="640" />
          <div>
            <span class="label">记录者 / CREW</span>
            <strong>WEI_ER</strong>
            <p>LLM / AGENT / ALIGNMENT</p>
          </div>
        </aside>
      </div>

      <div class="orbital-hero__foot" data-hero style="--delay: 0.3s">
        <span class="label">SCROLL / 向下进入观测舱</span>
        <span class="label">DEEP SPACE / 2026</span>
      </div>
    </div>
  </section>

  <section class="station-section" id="logs">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">01 / TRANSMISSIONS</span>
        <span class="section-label__meta">LOG COUNT / {postCount}</span>
      </div>
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">OBSERVATION LOGS</p>
          <h2>观测记录</h2>
        </div>
        <a class="link" href={href('writing/')}>全部记录 ↗</a>
      </div>

      {posts.length > 0 ? (
        <div class="log-list">
          {posts.map((post, index) => (
            <a class="log-row" href={href(`writing/${post.slug}/`)} data-reveal>
              <span class="log-row__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="log-row__body">
                <span class="log-row__meta">{formatDate(post.data.pubDate)} / {post.data.tags.slice(0, 2).join(' / ') || 'NOTE'}</span>
                <strong>{post.data.title}</strong>
                {post.data.description && <span class="log-row__desc">{post.data.description}</span>}
              </span>
              <span class="log-row__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-log" data-reveal>
          <div class="empty-log__number">000</div>
          <div class="empty-log__copy">
            <p class="kicker">NO TRANSMISSION YET</p>
            <h3>还没有记录。</h3>
            <p>
              等第一篇文章写完，它会出现在这里。不用占位内容凑数，也不假装这里已经有人读过。
            </p>
            <a class="link" href={href('writing/')}>打开记录页 ↗</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="station-section station-section--manifest" id="missions">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">02 / MISSION FILES</span>
        <span class="section-label__meta">FILES / {projectCount}</span>
      </div>
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">MISSION ARCHIVE</p>
          <h2>项目档案</h2>
        </div>
        <a class="link" href={href('projects/')}>全部项目 ↗</a>
      </div>

      {orderedProjects.length > 0 ? (
        <div class="manifest">
          {orderedProjects.map((project, index) => (
            <article class="manifest-row" data-reveal>
              <span class="manifest-row__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="manifest-row__body">
                <div class="manifest-row__top">
                  <h3>{project.title}</h3>
                  <span class="tag">{project.status}</span>
                </div>
                <p>{project.description}</p>
                <div class="manifest-row__meta">
                  <span>{project.year}</span>
                  {project.stack.slice(0, 3).map((item) => <span>{item}</span>)}
                  {project.repo && <a href={project.repo} target="_blank" rel="noreferrer">REPO ↗</a>}
                  {project.link && <a href={project.link} target="_blank" rel="noreferrer">OPEN ↗</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-manifest" data-reveal>
          <div class="empty-manifest__line"><span>001</span><span>—</span><span>未归档</span></div>
          <div class="empty-manifest__line"><span>002</span><span>—</span><span>未归档</span></div>
          <div class="empty-manifest__line"><span>003</span><span>—</span><span>未归档</span></div>
          <div class="empty-manifest__copy">
            <p class="kicker">STANDBY / NO VERIFIED FILE</p>
            <h3>只归档能说清<br />问题、方法和结果。</h3>
            <p>第一份可验证的档案还在准备中。没有链接、没有实验条件的项目，不会出现在这里。</p>
            <a class="link" href={href('projects/')}>查看项目页 ↗</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="station-section" id="observer">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">03 / OBSERVER</span>
        <span class="section-label__meta">WEI_ER / HUMAN</span>
      </div>
      <div class="home-about" data-reveal>
        <figure class="home-about__portrait">
          <img src={href('images/avatar.jpg')} alt="wei_er 的插画头像" width="640" height="640" />
          <figcaption><span>OBSERVER / 001</span><span>WEI_ER</span></figcaption>
        </figure>
        <div class="home-about__copy">
          <p class="kicker">THE OBSERVER</p>
          <h2>我是 wei_er，<br /><em>在轨道上观测的人。</em></h2>
          <p>
            AIUWEI 不是一家公司，也不是一个产品。它是我面对智能时使用的另一个身份，
            一座持续建设中的个人观测站。
          </p>
          <p>
            我更喜欢把“做 AI”理解成一种观测：提出假设，搭一个足够小的实验，
            记录它如何失败，再决定下一步。
          </p>
          <div class="home-about__foot">
            <span class="label">FOCUS / LLM · AGENT · ALIGNMENT</span>
            <a class="link" href={href('about/')}>完整档案 ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="closing__scene" aria-hidden="true"></div>
    <div class="container closing__inner" data-reveal>
      <p class="kicker">SIGNAL OPEN / 2026</p>
      <h2>先记录，<br /><em>再命名。</em></h2>
      <div class="closing__links">
        <a class="link" href={href('writing/')}>观测记录 ↗</a>
        <a class="link" href={href('projects/')}>项目档案 ↗</a>
        <a class="link" href={href('about/')}>关于记录者 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .orbital-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #02060d;
  }

  .orbital-hero__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .orbital-hero__stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(224, 246, 255, 0.8) 0.8px, transparent 0.8px),
      radial-gradient(rgba(150, 215, 245, 0.55) 0.6px, transparent 0.6px);
    background-size: 67px 59px, 127px 101px;
    background-position: 17px 11px, 43px 37px;
    opacity: 0.55;
  }

  .orbital-hero__sun {
    position: absolute;
    left: -260px;
    top: -420px;
    width: 1000px;
    height: 1000px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(210, 246, 255, 0.22), rgba(92, 180, 225, 0.08) 36%, transparent 68%);
    filter: blur(2px);
  }

  .orbital-hero__planet {
    position: absolute;
    right: -360px;
    bottom: -980px;
    width: 1600px;
    height: 1600px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 22%,
      #e8fcff 0,
      #a7ecff 4%,
      #3d9bc8 13%,
      #135a80 28%,
      #06283f 50%,
      #010a12 72%,
      #000204 88%
    );
    box-shadow: 0 0 100px rgba(95, 195, 240, 0.12);
    animation: planet-drift 26s ease-in-out infinite alternate;
  }

  .orbital-hero__planet::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: repeating-linear-gradient(
      8deg,
      transparent 0 38px,
      rgba(214, 248, 255, 0.06) 39px 41px,
      transparent 42px 92px
    );
    mix-blend-mode: screen;
    opacity: 0.55;
    pointer-events: none;
  }

  .orbital-hero__planet::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(118deg, transparent 12%, rgba(0, 4, 10, 0.16) 48%, rgba(0, 2, 7, 0.72) 100%);
    pointer-events: none;
  }

  .orbital-hero__atmosphere {
    position: absolute;
    right: -390px;
    bottom: -950px;
    width: 1650px;
    height: 1650px;
    border-radius: 50%;
    border: 1px solid rgba(177, 235, 255, 0.45);
    box-shadow: 0 0 55px rgba(110, 210, 255, 0.14);
    animation: planet-drift 26s ease-in-out infinite alternate;
  }

  .orbital-hero__station {
    position: absolute;
    right: -40px;
    top: 18%;
    width: min(1180px, 82vw);
    opacity: 0.96;
    animation: station-drift 18s ease-in-out infinite alternate;
  }

  .orbital-hero__grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(120, 200, 235, 0.035) 1px, transparent 1px),
      linear-gradient(rgba(120, 200, 235, 0.025) 1px, transparent 1px);
    background-size: 120px 120px;
    mask-image: radial-gradient(ellipse at 68% 45%, #000 0, transparent 68%);
    opacity: 0.5;
  }

  .orbital-hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(2, 6, 13, 0.95) 0%, rgba(2, 6, 13, 0.72) 34%, rgba(2, 6, 13, 0.15) 68%, rgba(2, 6, 13, 0.42) 100%),
      linear-gradient(to bottom, rgba(2, 6, 13, 0.55) 0%, transparent 24%, transparent 64%, rgba(2, 6, 13, 0.92) 100%);
  }

  .orbital-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + 24px);
    padding-bottom: 24px;
  }

  .orbital-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .orbital-hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(30px, 5vw, 80px);
    align-items: end;
    margin-top: auto;
    padding-block: clamp(50px, 8vh, 110px);
  }

  .orbital-hero__copy {
    max-width: 800px;
  }

  .orbital-hero__title {
    margin-top: 20px;
  }

  .orbital-hero__en {
    display: block;
    color: var(--ice);
    font-size: clamp(72px, 8vw, 118px);
    font-weight: 300;
    letter-spacing: 0.1em;
    line-height: 0.82;
  }

  .orbital-hero__cn {
    display: block;
    margin-top: 24px;
    color: var(--text);
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 300;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .orbital-hero__cn em {
    font-style: normal;
    color: var(--ice);
    border-bottom: 1px solid var(--cyan);
  }

  .orbital-hero__lede {
    max-width: 37em;
    margin-top: 24px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.9;
  }

  .orbital-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
    margin-top: 28px;
  }

  .orbital-hero__crew {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 8px;
  }

  .orbital-hero__crew img {
    width: 76px;
    height: 76px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .orbital-hero__crew div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .orbital-hero__crew strong {
    color: var(--ice);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.14em;
  }

  .orbital-hero__crew p {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
  }

  .orbital-hero__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .station-section {
    position: relative;
    padding-block: clamp(76px, 9vw, 128px);
    border-top: 1px solid var(--line);
    background: #02060d;
  }

  .station-section--manifest {
    background:
      radial-gradient(ellipse 55% 60% at 82% 10%, rgba(15, 58, 92, 0.2), transparent 68%),
      #02060d;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    padding-block: 24px 34px;
  }

  .section-head h2 {
    margin-top: 10px;
    color: var(--ice);
    font-size: clamp(42px, 5.4vw, 72px);
    font-weight: 300;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .section-head .link {
    flex: 0 0 auto;
    margin-bottom: 8px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .log-list {
    border-top: 1px solid var(--line);
  }

  .log-row {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.25s ease, padding-left 0.25s var(--ease);
  }

  .log-row:hover {
    padding-left: 10px;
    background: rgba(123, 220, 255, 0.035);
  }

  .log-row__index,
  .log-row__arrow {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .log-row__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .log-row__meta {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .log-row__body strong {
    color: var(--ice);
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .log-row__desc {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .log-row__arrow {
    color: var(--cyan);
    font-size: 16px;
  }

  .empty-log {
    display: grid;
    grid-template-columns: minmax(180px, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: center;
    padding-block: clamp(30px, 5vw, 60px);
  }

  .empty-log__number {
    color: transparent;
    font-size: clamp(110px, 17vw, 240px);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 0.8;
    -webkit-text-stroke: 1px rgba(160, 224, 250, 0.5);
  }

  .empty-log__copy h3 {
    margin-top: 12px;
    color: var(--ice);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: 0.03em;
  }

  .empty-log__copy p:not(.kicker) {
    max-width: 38em;
    margin-top: 16px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .empty-log__copy .link {
    margin-top: 22px;
  }

  .empty-manifest {
    padding-top: 8px;
  }

  .empty-manifest__line {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .empty-manifest__line span:nth-child(2) {
    color: var(--line-strong);
    text-align: center;
  }

  .empty-manifest__copy {
    max-width: 680px;
    padding-top: clamp(40px, 7vw, 80px);
  }

  .empty-manifest__copy h3 {
    margin-top: 14px;
    color: var(--ice);
    font-size: clamp(32px, 4.2vw, 56px);
    font-weight: 300;
    line-height: 1.25;
  }

  .empty-manifest__copy p:not(.kicker) {
    max-width: 36em;
    margin-top: 18px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .empty-manifest__copy .link {
    margin-top: 24px;
  }

  .manifest {
    border-top: 1px solid var(--line);
  }

  .manifest-row {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }

  .manifest-row__index {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 11px;
