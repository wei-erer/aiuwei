---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AvatarFrame from '../components/AvatarFrame.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, href } from '../data/site';
import { getPosts } from '../lib/content';
import { projects as allProjects } from '../content/projects';

const allPosts = getPosts();
const posts = allPosts.slice(0, 3);
const orderedProjects = [...allProjects]
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 3);
const postCount = String(allPosts.length).padStart(2, '0');
const projectCount = String(allProjects.length).padStart(2, '0');
---

<BaseLayout cover={true}>
  <section class="home-hero">
    <div class="container">
      <div class="home-hero__top">
        <span class="kicker">AI OBSERVATORY / ISSUE 001</span>
        <span class="label">DEEP SPACE / {site.established}</span>
        <span class="label">SCROLL TO READ ↓</span>
      </div>

      <div class="home-hero__grid">
        <div class="home-hero__copy">
          <p class="kicker" data-hero style="--delay: 0.04s">AI / PROJECTS / WRITING / PLAY</p>
          <h1 class="home-hero__title" data-hero style="--delay: 0.1s">
            <span class="home-hero__en">AIUWEI</span>
            <span class="home-hero__cn">在深空里，<br /><em>记录智能的微光。</em></span>
          </h1>
          <p class="home-hero__lede" data-hero style="--delay: 0.18s">
            我是 wei_er。这里记录我对 LLM、Agent、RAG 与 AI
            安全/对齐的观察、实验和项目。不追热点，只留下可复用的过程与判断。
          </p>
          <ul class="home-hero__tags" data-hero style="--delay: 0.24s" aria-label="关注方向">
            {site.focus.map((item) => <li>{item}</li>)}
            <li>BUILDING IN PUBLIC</li>
          </ul>
          <div class="home-hero__actions" data-hero style="--delay: 0.3s">
            <a class="btn btn--solid" href="#signals">
              <span>开始阅读</span><span class="btn__arrow" aria-hidden="true">↓</span>
            </a>
            <a class="btn" href={href('lab/')}>
              <span>去玩两个小游戏</span><span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="home-collage" data-hero style="--delay: 0.16s" aria-label="AIUWEI 视觉拼贴">
          <div class="home-collage__card home-collage__card--acid">
            <span class="label">SIGNAL / 001</span>
            <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
              <circle cx="60" cy="60" r="4" fill="currentColor" />
              <ellipse cx="60" cy="60" rx="44" ry="17" transform="rotate(-28 60 60)" stroke="currentColor" stroke-width="1.2" />
              <ellipse cx="60" cy="60" rx="44" ry="17" transform="rotate(34 60 60)" stroke="currentColor" stroke-width="1.2" />
              <circle cx="96" cy="35" r="3" fill="currentColor" />
            </svg>
            <span class="mono home-collage__micro">AIUWEI OBSERVATORY<br />2026 / DEEP SPACE</span>
          </div>

          <figure class="home-collage__card home-collage__card--photo">
            <span class="home-collage__tape" aria-hidden="true"></span>
            <img src={href('images/avatar.jpg')} alt="wei_er 的插画头像" width="640" height="640" />
            <figcaption><span>OBSERVER</span><strong>WEI_ER</strong></figcaption>
          </figure>

          <div class="home-collage__card home-collage__card--blue">
            <span class="label">FOCUS</span>
            <p>LLM<br />AGENT<br />ALIGNMENT</p>
            <span class="mono home-collage__micro">ISSUE 001 / EST. 2026</span>
          </div>

          <div class="home-collage__card home-collage__card--paper">
            <span class="label">CURRENTLY</span>
            <ul>
              <li>OBSERVING</li>
              <li>BUILDING</li>
              <li>WRITING</li>
            </ul>
            <span class="mono home-collage__micro">STATUS / OPEN</span>
          </div>

          <div class="home-collage__barcode" aria-hidden="true">
            <span></span>
            <small>AIUWEI · 001 · WEI_ER</small>
          </div>
        </div>
      </div>

      <div class="home-hero__foot" data-hero style="--delay: 0.36s">
        <div><span class="label">RECORD</span><strong>WEI_ER</strong></div>
        <div><span class="label">FOCUS</span><strong>LLM / AGENT / ALIGNMENT</strong></div>
        <div><span class="label">STATUS</span><strong><i class="status-dot"></i> OBSERVING</strong></div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__inner">
      <div class="marquee__group">
        <span>AIUWEI OBSERVATORY</span><span>ISSUE 001</span><span>LLM / AGENT / ALIGNMENT</span><span>记录智能的微光</span>
      </div>
      <div class="marquee__group">
        <span>AIUWEI OBSERVATORY</span><span>ISSUE 001</span><span>LLM / AGENT / ALIGNMENT</span><span>记录智能的微光</span>
      </div>
    </div>
  </div>

  <section class="section" id="signals">
    <div class="container">
      <SectionHeading
        index="01"
        en="TRANSMISSIONS / LATEST"
        title="观测记录"
        link={href('writing/')}
        linkLabel="全部记录"
      />

      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post, index) => <PostRow post={post} index={index} />)}
        </div>
      ) : (
        <div class="signal-empty" data-reveal>
          <div class="signal-empty__left">
            <p class="label">TRANSMISSION COUNT</p>
            <p class="signal-empty__number">00</p>
            <p class="signal-empty__status"><span class="status-dot"></span> CHANNEL OPEN</p>
          </div>
          <div class="signal-empty__right">
            <p class="kicker">FIELD NOTES / 000</p>
            <h3>第一条记录，<br /><em>还在深空里。</em></h3>
            <p>
              这里会存放实验记录、论文笔记和项目复盘。等 wei_er 写下第一篇，它会以时间戳的形式出现在这页纸上。
            </p>
            <div class="signal-empty__cats">
              <span>实验记录</span><span>论文笔记</span><span>项目复盘</span>
            </div>
            <a class="link" href={href('writing/')}>打开记录页 ↗</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <SectionHeading
        index="02"
        en="MISSION FILES / PROJECTS"
        title="项目档案"
        link={href('projects/')}
        linkLabel="全部任务"
      />

      {orderedProjects.length > 0 ? (
        <div class="project-grid">
          {orderedProjects.map((project, index) => (
            <ProjectCard project={project} accent={index === 0 ? 'acid' : index === 1 ? 'blue' : 'orange'} />
          ))}
        </div>
      ) : (
        <div class="project-empty" data-reveal>
          <div class="project-empty__slots">
            {[1, 2, 3].map((slot) => (
              <article class:list={['index-slot', slot === 1 ? 'index-slot--acid' : slot === 2 ? 'index-slot--blue' : 'index-slot--orange']}>
                <div class="index-slot__top">
                  <span class="mono">SLOT {String(slot).padStart(2, '0')}</span>
                  <span class="tag">OPEN</span>
                </div>
                <span class="index-slot__number">{String(slot).padStart(2, '0')}</span>
                <div class="index-slot__lines" aria-hidden="true"><span></span><span></span><span></span></div>
                <p class="index-slot__note">等待第一份任务档案</p>
              </article>
            ))}
          </div>
          <div class="project-empty__note">
            <p class="kicker">MISSION CONTROL</p>
            <h3>不用虚构项目，<br /><em>空着也成立。</em></h3>
            <p>
              项目会以“问题 / 方法 / 结果 / 链接”的格式归档。没有可验证链接的项目，不会出现在这里。
            </p>
            <a class="link" href={href('projects/')}>查看项目索引 ↗</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="lab">
    <div class="container">
      <SectionHeading
        index="03"
        en="PLAYGROUND / LAB"
        title="实验室"
        link={href('lab/')}
        linkLabel="进入 Lab"
      />

      <div class="game-grid" data-reveal>
        <a class="game-card game-card--blue" href={`${href('lab/')}#ai-or-human`}>
          <div class="game-card__top">
            <span class="tag tag--acid">GAME 01</span>
            <span class="label">6 题 / 2 分钟</span>
          </div>
          <h3>HUMAN<br />OR AI?</h3>
          <p class="game-card__cn">AI 真假判断</p>
          <p class="game-card__desc">两段文字，猜哪段是 AI 写的。答完给解析，不需要操作技巧。</p>
          <span class="game-card__cta">开始判断 <span aria-hidden="true">↗</span></span>
        </a>

        <a class="game-card game-card--acid" href={`${href('lab/')}#token-match`}>
          <div class="game-card__top">
            <span class="tag">GAME 02</span>
            <span class="label">60 秒 / 12 张卡</span>
          </div>
          <h3>ATTENTION<br />MATCH</h3>
          <p class="game-card__cn">Token 注意力配对</p>
          <p class="game-card__desc">翻开两张卡，找出语义相关的一对。配对成功会亮起一条注意力线。</p>
          <span class="game-card__cta">开始配对 <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <SectionHeading
        index="04"
        en="THE OBSERVER / ABOUT"
        title="记录者"
        link={href('about/')}
        linkLabel="完整档案"
      />

      <div class="about-home" data-reveal>
        <AvatarFrame compact />
        <div class="about-home__copy">
          <p class="kicker">CALLSIGN / WEI_ER</p>
          <h3>我是 wei_er，<br /><em>在深空里持续观测的人。</em></h3>
          <p>
            关注 LLM、Agent、RAG 与 AI 安全/对齐。AIUWEI
            是我的 AI 身份，也是这座观测站的名字。这里没有标准答案，只有持续更新的记录。
          </p>
          <dl class="about-home__facts">
            <div><dt>记录者</dt><dd>WEI_ER</dd></div>
            <div><dt>AI 身份</dt><dd>AIUWEI</dd></div>
            <div><dt>关注</dt><dd>LLM / AGENT / ALIGNMENT</dd></div>
            <div><dt>状态</dt><dd><i class="status-dot"></i> OBSERVING</dd></div>
          </dl>
          <div class="about-home__actions">
            <a class="btn" href={href('about/')}><span>更多关于我</span><span class="btn__arrow" aria-hidden="true">↗</span></a>
            <a class="link" href={site.github} target="_blank" rel="noreferrer">GITHUB ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing__inner">
      <p class="kicker">SIGNAL OPEN / 2026</p>
      <p class="closing__quote">先记录，<br /><em>再命名。</em></p>
      <div class="closing__links">
        <a href={href('writing/')}>观测记录 ↗</a>
        <a href={href('projects/')}>项目档案 ↗</a>
        <a href={href('lab/')}>实验室 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: var(--blue);
    vertical-align: 0.08em;
  }

  /* =========================================================
     Hero
     ========================================================= */

  .home-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + 18px);
    padding-bottom: 0;
    border-bottom: 1px solid var(--ink);
  }

  .home-hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--ink);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: clamp(28px, 5vw, 82px);
    align-items: center;
    padding-block: clamp(42px, 6vw, 78px);
  }

  .home-hero__copy {
    position: relative;
    z-index: 2;
  }

  .home-hero__title {
    margin-top: 20px;
  }

  .home-hero__en {
    display: block;
    font-family: var(--font-sans);
    font-size: clamp(82px, 12vw, 178px);
    font-weight: 600;
    letter-spacing: -0.085em;
    line-height: 0.75;
  }

  .home-hero__cn {
    display: block;
    margin-top: clamp(22px, 3vw, 34px);
    font-family: var(--font-serif);
    font-size: clamp(30px, 4.2vw, 54px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.28;
  }

  .home-hero__cn em {
    background: linear-gradient(transparent 55%, var(--acid) 55%, var(--acid) 93%, transparent 93%);
    color: var(--ink);
    font-style: normal;
  }

  .home-hero__lede {
    max-width: 48ch;
    margin-top: 24px;
    color: var(--ink-2);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.9;
  }

  .home-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .home-hero__tags li {
    padding: 4px 7px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .home-hero__actions .btn {
    width: auto;
  }

  .home-hero__foot {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-block: 16px;
    border-top: 1px solid var(--ink);
  }

  .home-hero__foot > div {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .home-hero__foot strong {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* Collage */
  .home-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr auto;
    gap: 10px;
    width: min(100%, 520px);
    justify-self: end;
    transform: rotate(1.5deg);
  }

  .home-collage__card {
    position: relative;
    min-height: 156px;
    border: 1px solid var(--ink);
    overflow: hidden;
  }

  .home-collage__card--acid {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 13px;
    background: var(--acid);
  }

  .home-collage__card--acid svg {
    width: 70%;
    margin-inline: auto;
  }

  .home-collage__micro {
    color: var(--ink-2);
    font-size: 8px;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .home-collage__card--photo {
    display: flex;
    flex-direction: column;
    margin: 0;
    background: var(--paper-3);
  }

  .home-collage__card--photo img {
    width: 100%;
    flex: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
  }

  .home-collage__card--photo figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    padding: 8px 10px;
    border-top: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.04em;
  }

  .home-collage__card--photo figcaption strong {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
  }

  .home-collage__tape {
    position: absolute;
    top: 8px;
    left: 50%;
    z-index: 2;
    width: 72px;
    height: 18px;
    border: 1px solid rgba(16, 16, 14, 0.16);
    background: rgba(255, 255, 255, 0.55);
    transform: translateX(-50%) rotate(-2deg);
    backdrop-filter: blur(1px);
  }

  .home-collage__card--blue {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 13px;
    background: var(--blue);
    color: #fff;
  }

  .home-collage__card--blue .label,
  .home-collage__card--blue .home-collage__micro {
    color: rgba(255, 255, 255, 0.82);
  }

  .home-collage__card--blue p {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.4vw, 34px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .home-collage__card--paper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 13px;
    background: var(--paper-3);
  }

  .home-collage__card--paper ul {
    margin-block: 12px;
  }

  .home-collage__card--paper li {
    padding: 5px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .home-collage__barcode {
    display: flex;
    grid-column: 1 / -1;
    flex-direction: column;
    gap: 4px;
    padding-top: 2px;
  }

  .home-collage__barcode span {
    height: 34px;
    background: repeating-linear-gradient(
      to right,
      var(--ink) 0 2px,
      transparent 2px 5px,
      var(--ink) 5px 6px,
      transparent 6px 11px,
      var(--ink) 11px 14px,
      transparent 14px 17px
    );
  }

  .home-collage__barcode small {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  /* Hero entrance waits for the cover. */
  .js .home-hero [data-hero] {
    opacity: 0;
    transform: translateY(20px);
  }

  .js body.cover-complete .home-hero [data-hero],
  .js body:not(.has-cover) .home-hero [data-hero] {
    animation: hero-rise 0.8s var(--ease) var(--delay, 0s) both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* =========================================================
     Empty signals
     ========================================================= */

  .post-list {
    border-top: 1px solid var(--ink);
  }

  .signal-empty {
    display: grid;
    grid-template-columns: minmax(180px, 0.46fr) minmax(0, 1.54fr);
    gap: clamp(28px, 6vw, 90px);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .signal-empty__left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 24px 24px 24px 0;
    border-right: 1px solid var(--ink);
  }

  .signal-empty__number {
    margin-block: auto;
    font-family: var(--font-sans);
    font-size: clamp(110px, 14vw, 190px);
    font-weight: 600;
    letter-spacing: -0.1em;
    line-height: 0.72;
  }

  .signal-empty__status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .signal-empty__status .status-dot {
    background: var(--orange);
  }

  .signal-empty__right {
    padding: 30px 0 30px 12px;
  }

  .signal-empty__right h3 {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: clamp(36px, 4.8vw, 66px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.12;
  }

  .signal-empty__right h3 em {
    background: linear-gradient(transparent 55%, var(--acid) 55%, var(--acid) 93%, transparent 93%);
    font-style: normal;
  }

  .signal-empty__right > p:not(.kicker) {
    max-width: 52ch;
    margin-top: 18px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .signal-empty__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .signal-empty__cats span {
    padding: 4px 8px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .signal-empty__right .link {
    display: inline-block;
    margin-top: 26px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  /* =========================================================
     Projects empty
     ========================================================= */

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 16px;
  }

  .project-empty {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: 16px;
  }

  .project-empty__slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .index-slot {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
  }

  .index-slot--acid {
    border-top: 8px solid var(--acid);
  }

  .index-slot--blue {
    border-top: 8px solid var(--blue);
  }

  .index-slot--orange {
    border-top: 8px solid var(--orange);
  }

  .index-slot__top {
