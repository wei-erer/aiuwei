---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AvatarFrame from '../components/AvatarFrame.astro';
import { href, site } from '../data/site';
---

<BaseLayout title="关于记录者" description="关于 wei_er 与 AIUWEI：一个在 AI 深空里持续观测的人，以及这座观测站的由来。">
  <PageHeader
    index="04"
    en="THE OBSERVER / ABOUT"
    title="关于记录者"
    titleEn="THE OBSERVER"
    description="wei_er 是记录者，AIUWEI 是这座观测站的名字，也是他在 AI 世界里的另一个身份。"
    meta={['记录者 / WEI_ER', 'AI 身份 / AIUWEI', '状态 / OBSERVING']}
    stamp={`ISSUE\n001`}
  />

  <section class="section">
    <div class="container">
      <div class="profile" data-reveal>
        <div class="profile__photo">
          <AvatarFrame />
          <p class="label">IDENTITY CARD / AIUWEI 001</p>
        </div>

        <div class="profile__copy">
          <p class="kicker">SIGNAL ORIGIN / 001</p>
          <h2>我是 wei_er，<br /><em>在 AI 深空里持续观测的人。</em></h2>
          <p class="profile__lede">
            关注 LLM、Agent、RAG 与 AI 安全/对齐。AIUWEI
            不是一家公司，也不是一个产品；它是我面对智能时使用的另一个身份，一座持续建设中的个人观测站。
          </p>
          <p class="profile__body">
            我更喜欢把“做 AI”理解成一种观测：提出假设，搭一个足够小的实验，记录它如何失败，再决定下一步。
            这个站点不追热点，也不把未经验证的东西包装成结论。它只负责把过程留下来。
          </p>

          <blockquote class="profile__quote">
            <span aria-hidden="true">“</span>
            <p>先记录，再命名。<br />让每一次实验都有坐标。</p>
          </blockquote>
        </div>
      </div>

      <div class="about-grid" data-reveal>
        <section class="about-panel about-panel--acid">
          <p class="kicker">FOCUS / 002</p>
          <h3>正在观测的方向</h3>
          <ul class="focus-list">
            <li><span>01</span><div><strong>LLM / Agent / RAG</strong><em>模型应用与上下文工程</em></div></li>
            <li><span>02</span><div><strong>AI Safety / Alignment</strong><em>行为评测、风险与边界</em></div></li>
            <li><span>03</span><div><strong>Building in Public</strong><em>把过程写成可复用的记录</em></div></li>
          </ul>
        </section>

        <section class="about-panel about-panel--blue">
          <p class="kicker">PROTOCOL / 003</p>
          <h3>这座站的三个原则</h3>
          <ol class="principle-list">
            <li><span>01</span><div><strong>可验证</strong><p>项目与结论尽量留下链接、代码或实验条件。</p></div></li>
            <li><span>02</span><div><strong>可复用</strong><p>记录失败路径，而不只是展示成功结果。</p></div></li>
            <li><span>03</span><div><strong>可更新</strong><p>允许观点变化，但保留修改前后的坐标。</p></div></li>
          </ol>
        </section>
      </div>

      <div class="uplink" data-reveal>
        <div>
          <p class="kicker">UPLINK / OPEN CHANNEL</p>
          <p>如果你想聊 Agent、评测、AI 安全，或者只是想指出我哪里写错了，欢迎从 GitHub 找到我。</p>
        </div>
        <a class="btn btn--solid" href={site.github} target="_blank" rel="noreferrer">
          <span>GITHUB / WEI-ERER</span><span class="btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="page-foot" data-reveal>
        <p class="label">AIUWEI OBSERVATORY / 记录者 WEI_ER</p>
        <a class="link" href={href('writing/')}>读取观测记录 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: center;
  }

  .profile__photo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .profile__copy h2 {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: clamp(34px, 4.8vw, 62px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.2;
  }

  .profile__copy h2 em {
    background: linear-gradient(transparent 56%, var(--acid) 56%, var(--acid) 93%, transparent 93%);
    font-style: normal;
  }

  .profile__lede {
    max-width: 54ch;
    margin-top: 24px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.95;
  }

  .profile__body {
    max-width: 58ch;
    margin-top: 14px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.95;
  }

  .profile__quote {
    display: flex;
    gap: 14px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
  }

  .profile__quote > span {
    color: var(--blue);
    font-family: var(--font-serif);
    font-size: 36px;
    line-height: 0.8;
  }

  .profile__quote p {
    color: var(--ink-2);
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.7;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(54px, 8vw, 96px);
  }

  .about-panel {
    padding: clamp(24px, 3.4vw, 40px);
    border: 1px solid var(--ink);
  }

  .about-panel--acid {
    background: var(--acid);
  }

  .about-panel--blue {
    background: var(--blue);
    color: #fff;
  }

  .about-panel--blue .kicker,
  .about-panel--blue .kicker::before {
    color: var(--ink);
  }

  .about-panel h3 {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .focus-list,
  .principle-list {
    display: flex;
    flex-direction: column;
    margin-top: 24px;
    border-top: 1px solid currentColor;
  }

  .focus-list li,
  .principle-list li {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(16, 16, 14, 0.24);
  }

  .about-panel--blue .principle-list li {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .focus-list > li > span,
  .principle-list > li > span {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.8;
  }

  .focus-list div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .focus-list strong {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .focus-list em {
    color: var(--ink-2);
    font-size: 13px;
    font-style: normal;
  }

  .principle-list strong {
    display: block;
    margin-bottom: 3px;
    font-size: 15px;
    font-weight: 600;
  }

  .principle-list p {
    color: inherit;
    font-size: 13px;
    line-height: 1.8;
    opacity: 0.82;
  }

  .uplink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 16px;
    padding: clamp(24px, 3.4vw, 40px);
    border: 1px solid var(--ink);
    background: var(--paper-3);
  }

  .uplink > div {
    max-width: 62ch;
  }

  .uplink p:not(.kicker) {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.9;
  }

  .uplink .btn {
    flex: 0 0 auto;
    width: auto;
  }

  .page-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 52px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }

  .page-foot .link {
    font-family: var(--font-mono);
    font-size: 10px;
  }

  @media (max-width: 960px) {
    .profile {
      grid-template-columns: 1fr;
    }

    .profile__photo {
      align-items: flex-start;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .uplink {
      align-items: stretch;
      flex-direction: column;
    }

    .uplink .btn {
      width: 100%;
    }

    .page-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
