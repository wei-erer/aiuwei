---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, href } from '../data/site';
---

<BaseLayout title="关于记录者" description="wei_er 是 AIUWEI 的记录者。关注 LLM、Agent 与 AI 安全/对齐。">
  <PageHeader
    index="03"
    label="THE OBSERVER / ABOUT"
    title="关于记录者"
    titleEn="THE OBSERVER"
    description="wei_er 是记录者。AIUWEI 是这座观测站的名字，也是他在 AI 世界里的另一个身份。"
    meta={['记录者 / WEI_ER', 'AI 身份 / AIUWEI', '状态 / OBSERVING']}
  />

  <section class="section">
    <div class="container">
      <div class="profile" data-reveal>
        <figure class="profile__portrait">
          <img src={href('images/avatar.jpg')} alt="wei_er 的插画头像" width="640" height="640" />
          <figcaption>
            <span>OBSERVER / 001</span>
            <span>WEI_ER</span>
          </figcaption>
        </figure>

        <div class="profile__copy">
          <p class="kicker">SIGNAL ORIGIN / 001</p>
          <h2>我是 wei_er，<br /><em>在轨道上观测的人。</em></h2>
          <p>
            关注 LLM、Agent、RAG 与 AI 安全/对齐。AIUWEI 不是一家公司，也不是一个产品；
            它是我面对智能时使用的另一个身份，一座持续建设中的个人观测站。
          </p>
          <p>
            我更喜欢把“做 AI”理解成一种观测：提出假设，搭一个足够小的实验，记录它如何失败，
            再决定下一步。这个站点不追热点，也不把未经验证的东西包装成结论。它只负责把过程留下来。
          </p>
          <blockquote>
            <p>先记录，再命名。</p>
            <p>让每一次实验都有坐标。</p>
          </blockquote>
        </div>
      </div>

      <div class="details" data-reveal>
        <section class="detail-block" aria-labelledby="focus-title">
          <div class="detail-block__head">
            <span class="label">01 / FOCUS</span>
            <h3 id="focus-title">正在观测的方向</h3>
          </div>
          <ol class="focus-list">
            <li><span>01</span><div><strong>LLM / Agent / RAG</strong><p>模型应用与上下文工程</p></div></li>
            <li><span>02</span><div><strong>AI Safety / Alignment</strong><p>行为评测、风险与边界</p></div></li>
            <li><span>03</span><div><strong>Building in Public</strong><p>把过程写成可复用的记录</p></div></li>
          </ol>
        </section>

        <section class="detail-block" aria-labelledby="protocol-title">
          <div class="detail-block__head">
            <span class="label">02 / PROTOCOL</span>
            <h3 id="protocol-title">这座站的三个原则</h3>
          </div>
          <ol class="protocol-list">
            <li><span>01</span><div><strong>可验证</strong><p>项目与结论尽量留下链接、代码或实验条件。</p></div></li>
            <li><span>02</span><div><strong>可复用</strong><p>记录失败路径，而不只是展示成功结果。</p></div></li>
            <li><span>03</span><div><strong>可更新</strong><p>允许观点变化，但保留修改前后的坐标。</p></div></li>
          </ol>
        </section>
      </div>

      <div class="uplink" data-reveal>
        <div>
          <p class="kicker">UPLINK / OPEN CHANNEL</p>
          <p>如果你想聊 Agent、评测、AI 安全，或者只是想指出我哪里写错了，欢迎从 GitHub 找到我。</p>
        </div>
        <a class="btn" href={site.github} target="_blank" rel="noreferrer"><span>GITHUB / WEI-ERER</span><span class="btn__arrow" aria-hidden="true">↗</span></a>
      </div>

      <div class="page-foot" data-reveal>
        <span class="label">AIUWEI OBSERVATORY / 记录者 WEI_ER</span>
        <a class="link" href={href('writing/')}>读取观测记录 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: center;
  }

  .profile__portrait {
    position: relative;
    max-width: 440px;
    padding: 10px;
    border: 1px solid var(--line);
    background: rgba(5, 17, 29, 0.4);
  }

  .profile__portrait::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(123, 220, 255, 0.16);
    pointer-events: none;
  }

  .profile__portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: none;
  }

  .profile__portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 2px 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  .profile__copy h2 {
    margin-top: 14px;
    color: var(--ice);
    font-size: clamp(38px, 5vw, 70px);
    font-weight: 300;
    line-height: 1.18;
  }

  .profile__copy h2 em {
    color: var(--cyan);
    font-style: normal;
  }

  .profile__copy > p:not(.kicker) {
    max-width: 40em;
    margin-top: 20px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.95;
  }

  .profile__copy blockquote {
    margin-top: 30px;
    padding-left: 20px;
    border-left: 1px solid var(--cyan);
    color: var(--text);
    font-size: 18px;
    line-height: 1.8;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 90px);
    margin-top: clamp(64px, 9vw, 120px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .detail-block__head {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .detail-block h3 {
    margin-top: 10px;
    color: var(--ice);
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 300;
  }

  .focus-list li,
  .protocol-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .focus-list span,
  .protocol-list span {
    padding-top: 4px;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .focus-list strong,
  .protocol-list strong {
    color: var(--text);
    font-size: 15px;
    font-weight: 400;
  }

  .focus-list p,
  .protocol-list p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .uplink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: clamp(56px, 8vw, 100px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .uplink > div {
    max-width: 52em;
  }

  .uplink p:not(.kicker) {
    margin-top: 10px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .uplink .btn {
    flex: 0 0 auto;
  }

  .page-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(48px, 7vw, 86px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .profile {
      grid-template-columns: 1fr;
    }

    .profile__portrait {
      width: min(390px, 100%);
    }

    .details {
      grid-template-columns: 1fr;
    }

    .uplink {
      align-items: flex-start;
      flex-direction: column;
    }

    .uplink .btn {
      width: 100%;
    }
  }

  @media (max-width: 700px) {
    .profile__copy h2 {
      font-size: 38px;
    }

    .profile__copy > p:not(.kicker) {
      font-size: 15px;
    }

    .page-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
