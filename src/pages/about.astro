---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AvatarFrame from '../components/AvatarFrame.astro';
import { href, site } from '../data/site';
---

<BaseLayout title="关于记录者" description="关于 wei_er 与 AIUWEI：一个在 AI 深空里持续观测的人，以及这座观测站的由来。">
  <PageHeader
    index="04"
    en="THE OBSERVER / ABOUT"
    title="关于记录者"
    titleEn="THE OBSERVER"
    description="wei_er 是记录者，AIUWEI 是这座观测站的名字，也是他在 AI 世界里的另一个身份。"
    meta={['CALLSIGN / WEI_ER', 'AI ALIAS / AIUWEI', 'STATUS / OBSERVING']}
  />

  <section class="section about-page">
    <div class="container">
      <div class="about-page__intro">
        <div class="about-page__visual" data-reveal>
          <AvatarFrame />
          <div class="about-page__id">
            <span>IDENTITY CARD</span>
            <span>AIUWEI / 001</span>
          </div>
        </div>

        <div class="about-page__copy" data-reveal style="--delay: 0.1s">
          <p class="eyebrow">SIGNAL ORIGIN / 001</p>
          <h2>我是 wei_er，<br /><em>在深空里持续观测的人。</em></h2>

          <p class="about-page__lede">
            这里记录我对 LLM、Agent、RAG 与 AI 安全/对齐的实验、项目和思考。AIUWEI
            不是一家公司，也不是一个产品，它是我面对智能时使用的另一个身份，一座持续建设中的个人观测站。
          </p>

          <p class="about-page__body">
            我更喜欢把“做 AI”理解成一种观测：提出假设，搭一个足够小的实验，记录它如何失败，再决定下一步。
            这个站点不会追逐每一个热点，也不会把未经验证的东西包装成结论。它只负责把过程留下来。
          </p>

          <div class="about-page__quote">
            <span aria-hidden="true">“</span>
            <p>先记录，再命名。<br />让每一次实验都有坐标。</p>
          </div>
        </div>
      </div>

      <div class="about-page__grid">
        <div class="about-page__panel panel" data-reveal>
          <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <p class="eyebrow">FOCUS / 002</p>
          <h3>正在观测的方向</h3>
          <ul class="about-page__focus">
            <li>
              <span>01</span>
              <div><strong>LLM / Agent / RAG</strong><em>模型应用与上下文工程</em></div>
            </li>
            <li>
              <span>02</span>
              <div><strong>AI SAFETY / ALIGNMENT</strong><em>行为评测、风险与边界</em></div>
            </li>
            <li>
              <span>03</span>
              <div><strong>BUILDING IN PUBLIC</strong><em>把过程写成可复用的记录</em></div>
            </li>
          </ul>
        </div>

        <div class="about-page__panel panel" data-reveal style="--delay: 0.08s">
          <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <p class="eyebrow">PROTOCOL / 003</p>
          <h3>这座站的三个原则</h3>
          <ol class="about-page__principles">
            <li><span>01</span><p><strong>可验证</strong>项目与结论尽量留下链接、代码或实验条件。</p></li>
            <li><span>02</span><p><strong>可复用</strong>记录失败路径，而不只是展示成功结果。</p></li>
            <li><span>03</span><p><strong>可更新</strong>允许观点变化，但保留修改前后的坐标。</p></li>
          </ol>
        </div>
      </div>

      <div class="about-page__uplink" data-reveal>
        <div>
          <p class="eyebrow">UPLINK / OPEN CHANNEL</p>
          <p>如果你想聊 Agent、评测、AI 安全，或者只是想指出我哪里写错了，欢迎从 GitHub 找到我。</p>
        </div>
        <a class="about-page__github" href={site.github} target="_blank" rel="noreferrer">
          <span>GITHUB / WEI-ERER</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="about-page__footer" data-reveal>
        <p>AIUWEI OBSERVATORY // 记录者 WEI_ER</p>
        <a href={href('writing/')}>读取观测记录 <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page__intro {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(40px, 8vw, 120px);
  }

  .about-page__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .about-page__id {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: min(100%, 360px);
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.12em;
  }

  .about-page__id span:last-child {
    color: var(--cyan);
    opacity: 0.7;
  }

  .about-page__copy .eyebrow {
    margin-bottom: 22px;
  }

  .about-page__copy h2 {
    font-family: var(--font-cn);
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1.28;
  }

  .about-page__copy h2 em {
    background: linear-gradient(100deg, var(--ink), var(--cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .about-page__lede {
    max-width: 54ch;
    margin-top: 28px;
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: 14px;
    line-height: 2;
  }

  .about-page__body {
    max-width: 56ch;
    margin-top: 16px;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 13px;
    line-height: 2;
  }

  .about-page__quote {
    position: relative;
    display: flex;
    gap: 16px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .about-page__quote > span {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 24px;
    line-height: 1;
    opacity: 0.5;
  }

  .about-page__quote p {
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: 16px;
    letter-spacing: 0.02em;
    line-height: 1.8;
  }

  .about-page__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(56px, 8vw, 100px);
  }

  .about-page__panel {
    padding: clamp(24px, 3vw, 38px);
  }

  .about-page__panel h3 {
    margin-top: 20px;
    font-family: var(--font-cn);
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 300;
    letter-spacing: -0.03em;
  }

  .about-page__focus {
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }

  .about-page__focus li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .about-page__focus li > span,
  .about-page__principles li > span {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 8px;
    opacity: 0.6;
  }

  .about-page__focus div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .about-page__focus strong {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .about-page__focus em {
    color: var(--ink-faint);
    font-family: var(--font-cn);
    font-size: 11px;
  }

  .about-page__principles {
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }

  .about-page__principles li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .about-page__principles p {
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 12px;
    line-height: 1.85;
  }

  .about-page__principles strong {
    display: block;
    margin-bottom: 4px;
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: 13px;
    font-weight: 400;
  }

  .about-page__uplink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 16px;
    padding: clamp(24px, 3vw, 38px);
    border: 1px solid var(--line);
    background:
      linear-gradient(130deg, rgba(100, 244, 223, 0.035), transparent 48%),
      rgba(5, 12, 22, 0.36);
  }

  .about-page__uplink p:not(.eyebrow) {
    max-width: 54ch;
    margin-top: 14px;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 12px;
    line-height: 1.9;
  }

  .about-page__github {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    flex: 0 0 auto;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    transition: color 0.3s ease;
  }

  .about-page__github span:last-child {
    color: var(--cyan);
    font-size: 14px;
    transition: transform 0.3s var(--ease);
  }

  .about-page__github:hover {
    color: var(--cyan);
  }

  .about-page__github:hover span:last-child {
    transform: translate(3px, -3px);
  }

  .about-page__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .about-page__footer a {
    color: var(--ink-muted);
    transition: color 0.3s ease;
  }

  .about-page__footer a span {
    color: var(--cyan);
  }

  .about-page__footer a:hover {
    color: var(--cyan);
  }

  @media (max-width: 960px) {
    .about-page__intro {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .about-page__visual {
      align-items: flex-start;
    }

    .about-page__id {
      width: min(100%, 420px);
    }

    .about-page__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .about-page__uplink {
      align-items: flex-start;
      flex-direction: column;
    }

    .about-page__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .about-page__copy h2 {
      font-size: 30px;
    }

    .about-page__quote p {
      font-size: 14px;
    }
  }
</style>
