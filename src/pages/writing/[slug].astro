---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime } from '../../lib/content';
import { href, site } from '../../data/site';

export function getStaticPaths() {
  return getPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const Content = post.Content;
const posts = getPosts();
const index = posts.findIndex((item) => item.slug === post.slug);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const date = formatDate(post.data.pubDate);
const updated = post.data.updatedDate ? formatDate(post.data.updatedDate) : undefined;
const toc = post.headings.filter((heading) => heading.depth <= 3);
const description = post.data.description || site.description;
const readTime = readingTime(post.raw);
---

<BaseLayout title={post.data.title} description={description}>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <article class="article">
    <header class="article__head">
      <div class="article__grid" aria-hidden="true"></div>
      <div class="container">
        <a class="article__back" href={href('writing/')}><span>←</span> 返回观测记录</a>

        <div class="article__kicker">
          <span class="eyebrow"><span class="status-dot"></span> TRANSMISSION / {String(index + 1).padStart(3, '0')}</span>
          <span class="article__date">{date}</span>
        </div>

        <h1 class="article__title">{post.data.title}</h1>
        {post.data.description && <p class="article__desc">{post.data.description}</p>}

        <div class="article__meta">
          <span>{readTime}</span>
          <span>LANG / ZH-CN</span>
          {updated && <span>UPDATED / {updated}</span>}
          {post.data.tags.length > 0 && (
            <div class="article__tags">
              {post.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="container article__layout">
      {toc.length > 1 ? (
        <aside class="article__toc" aria-label="文章目录">
          <p class="article__toc-label">ON THIS PAGE</p>
          <nav>
            {toc.map((heading) => (
              <a class:list={['article__toc-link', `article__toc-link--${heading.depth}`]} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </nav>
          <a class="article__toc-top" href="#top">BACK TO TOP ↑</a>
        </aside>
      ) : (
        <div class="article__toc article__toc--empty" aria-hidden="true">
          <p class="article__toc-label">TRANSMISSION</p>
          <span>READ IN THE DARK</span>
        </div>
      )}

      <div class="article__body prose" data-article-body>
        <Content />

        <div class="article__end">
          <span class="status-dot"></span>
          <p>END OF TRANSMISSION // 记录结束</p>
          <a href={href('writing/')}>返回全部记录 <span>↗</span></a>
        </div>
      </div>
    </div>

    {(newer || older) && (
      <nav class="container article__nav" aria-label="前后文章">
        {older ? (
          <a class="article__nav-item" href={href(`writing/${older.slug}/`)}>
            <span>← OLDER</span>
            <strong>{older.data.title}</strong>
          </a>
        ) : <span />}
        {newer ? (
          <a class="article__nav-item article__nav-item--next" href={href(`writing/${newer.slug}/`)}>
            <span>NEWER →</span>
            <strong>{newer.data.title}</strong>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>

  <script>
    const progress = document.querySelector('[data-reading-progress]');
    const body = document.querySelector('[data-article-body]');
    if (progress && body) {
      const update = () => {
        const rect = body.getBoundingClientRect();
        const total = Math.max(1, rect.height - window.innerHeight * 0.4);
        const value = Math.min(1, Math.max(0, (window.innerHeight * 0.25 - rect.top) / total));
        progress.style.transform = `scaleX(${value})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    height: 1px;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--cyan);
    box-shadow: 0 0 12px rgba(100, 244, 223, 0.6);
    transform: scaleX(0);
    transform-origin: left;
  }

  .article__head {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + clamp(52px, 8vw, 96px));
    padding-bottom: clamp(44px, 7vw, 80px);
    border-bottom: 1px solid var(--line);
  }

  .article__grid {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    background-image:
      linear-gradient(to right, rgba(100, 244, 223, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(100, 244, 223, 0.04) 1px, transparent 1px);
    background-size: 92px 92px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%);
    pointer-events: none;
  }

  .article__back {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 11px;
    letter-spacing: 0.08em;
    transition: color 0.3s ease;
  }

  .article__back span {
    color: var(--cyan);
  }

  .article__back:hover {
    color: var(--cyan);
  }

  .article__kicker {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(40px, 6vw, 68px);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }

  .article__date {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .article__title {
    position: relative;
    z-index: 1;
    max-width: 18em;
    margin-top: clamp(28px, 4vw, 46px);
    font-family: var(--font-cn);
    font-size: clamp(36px, 5.8vw, 76px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1.18;
  }

  .article__desc {
    position: relative;
    z-index: 1;
    max-width: 58ch;
    margin-top: 24px;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 14px;
    line-height: 1.95;
  }

  .article__meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 26px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .article__tags span {
    padding: 4px 7px;
    border: 1px solid var(--line);
    color: var(--cyan);
    font-size: 7px;
  }

  .article__layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    justify-content: center;
    gap: clamp(32px, 6vw, 80px);
    padding-top: clamp(48px, 7vw, 86px);
    padding-bottom: clamp(60px, 9vw, 120px);
  }

  .article__toc {
    position: sticky;
    top: calc(var(--nav-h) + 28px);
    align-self: start;
    padding-top: 6px;
  }

  .article__toc-label {
    margin-bottom: 16px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.16em;
  }

  .article__toc nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-left: 1px solid var(--line);
  }

  .article__toc-link {
    padding-left: 14px;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 11px;
    line-height: 1.6;
    transition: color 0.3s ease, border-color 0.3s ease;
    border-left: 1px solid transparent;
    margin-left: -1px;
  }

  .article__toc-link--3 {
    padding-left: 24px;
    color: var(--ink-faint);
    font-size: 10px;
  }

  .article__toc-link:hover {
    color: var(--cyan);
    border-left-color: var(--cyan);
  }

  .article__toc-top {
    display: inline-block;
    margin-top: 28px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.12em;
    transition: color 0.3s ease;
  }

  .article__toc-top:hover {
    color: var(--cyan);
  }

  .article__toc--empty span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.12em;
    opacity: 0.5;
  }

  .prose {
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: 15px;
    line-height: 2;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--ink);
    font-family: var(--font-cn);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.35;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .prose :global(h2) {
    margin-top: 2.2em;
    margin-bottom: 0.8em;
    font-size: clamp(24px, 3vw, 34px);
  }

  .prose :global(h2)::before {
    content: '§';
    margin-right: 12px;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.5em;
    vertical-align: 0.2em;
    opacity: 0.6;
  }

  .prose :global(h3) {
    margin-top: 1.8em;
    margin-bottom: 0.7em;
    font-size: 20px;
  }

  .prose :global(p) {
    margin: 1.2em 0;
  }

  .prose :global(a) {
    color: var(--cyan);
    border-bottom: 1px solid rgba(100, 244, 223, 0.35);
    transition: border-color 0.3s ease;
  }

  .prose :global(a:hover) {
    border-color: var(--cyan);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .prose :global(blockquote) {
    margin: 1.8em 0;
    padding: 4px 0 4px 22px;
    border-left: 1px solid var(--cyan);
    color: var(--ink-muted);
    font-size: 14px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.2em 0;
    padding-left: 1.4em;
  }

  .prose :global(ul) {
    list-style: square;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li) {
    margin: 0.55em 0;
    padding-left: 0.3em;
  }

  .prose :global(li::marker) {
    color: var(--cyan);
  }

  .prose :global(code) {
    padding: 2px 5px;
    border: 1px solid var(--line);
    background: rgba(100, 244, 223, 0.05);
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.84em;
  }

  .prose :global(pre) {
    margin: 1.8em 0;
    padding: 20px;
    border: 1px solid var(--line);
    background: rgba(4, 10, 18, 0.85);
    overflow-x: auto;
    font-size: 12px;
    line-height: 1.75;
  }

  .prose :global(pre.astro-code) {
    background: rgba(4, 10, 18, 0.9) !important;
    border-color: var(--line) !important;
    box-shadow: inset 0 1px 0 rgba(100, 244, 223, 0.05);
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font-size: inherit;
  }

  .prose :global(img) {
    width: 100%;
    margin: 1.8em 0;
    border: 1px solid var(--line);
  }

  .prose :global(hr) {
    margin: 2.8em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(table) {
    width: 100%;
    margin: 1.8em 0;
    border-collapse: collapse;
    font-size: 13px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--line);
    text-align: left;
  }

  .prose :global(th) {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    background: rgba(100, 244, 223, 0.04);
  }

  .article__end {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 64px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .article__end p {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .article__end a {
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 12px;
    transition: color 0.3s ease;
  }

  .article__end a span {
    color: var(--cyan);
  }

  .article__end a:hover {
    color: var(--cyan);
  }

  .article__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-bottom: clamp(60px, 9vw, 110px);
  }

  .article__nav-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border: 1px solid var(--line);
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  .article__nav-item:hover {
    border-color: var(--line-strong);
    background: rgba(8, 20, 34, 0.5);
  }

  .article__nav-item span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.12em;
  }

  .article__nav-item strong {
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
  }

  .article__nav-item--next {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 1040px) {
    .article__layout {
      grid-template-columns: 1fr;
    }

    .article__toc {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .article__kicker {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .article__title {
      font-size: clamp(32px, 10vw, 48px);
    }

    .prose {
      font-size: 14px;
    }

    .article__nav {
      grid-template-columns: 1fr;
    }

    .article__nav-item--next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
