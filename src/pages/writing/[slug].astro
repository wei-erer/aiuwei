---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime } from '../../lib/content';
import { href } from '../../data/site';

export function getStaticPaths() {
  return getPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const Content = post.Content;
const posts = getPosts();
const index = posts.findIndex((item) => item.slug === post.slug);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const date = formatDate(post.data.pubDate);
const toc = post.headings.filter((heading) => heading.depth <= 3);
const readTime = readingTime(post.raw ?? '');
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <article class="article">
    <header class="article__head">
      <div class="container">
        <div class="article__top">
          <a class="article__back" href={href('writing/')}>← 返回观测记录</a>
          <span class="label">TRANSMISSION / {String(index + 1).padStart(3, '0')}</span>
        </div>

        <p class="kicker">{date} / {readTime}</p>
        <h1 class="article__title">{post.data.title}</h1>
        {post.data.description && <p class="article__desc">{post.data.description}</p>}

        <div class="article__meta">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          <span class="label">WEI_ER / OBSERVATORY</span>
        </div>
      </div>
    </header>

    <div class="container article__layout">
      {toc.length > 1 ? (
        <aside class="article__toc" aria-label="文章目录">
          <p class="label">ON THIS PAGE</p>
          <nav>
            {toc.map((heading) => (
              <a class:list={['article__toc-link', `article__toc-link--${heading.depth}`]} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </nav>
          <a class="article__toc-top" href="#top">回到顶部 ↑</a>
        </aside>
      ) : (
        <div class="article__toc article__toc--empty" aria-hidden="true">
          <p class="label">TRANSMISSION</p>
          <span>DEEP SPACE / 2026</span>
        </div>
      )}

      <div class="article__body prose" data-article-body>
        <Content />

        <div class="article__end">
          <span class="label">END OF TRANSMISSION / 记录结束</span>
          <a class="link" href={href('writing/')}>返回全部记录 ↗</a>
        </div>
      </div>
    </div>

    {(newer || older) && (
      <nav class="container article__nav" aria-label="前后文章">
        {older ? (
          <a class="article__nav-item" href={href(`writing/${older.slug}/`)}>
            <span class="label">← OLDER</span>
            <strong>{older.data.title}</strong>
          </a>
        ) : <span />}
        {newer ? (
          <a class="article__nav-item article__nav-item--next" href={href(`writing/${newer.slug}/`)}>
            <span class="label">NEWER →</span>
            <strong>{newer.data.title}</strong>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>

  <script>
    const progress = document.querySelector('[data-reading-progress]');
    const body = document.querySelector('[data-article-body]');
    if (progress && body) {
      const update = () => {
        const rect = body.getBoundingClientRect();
        const total = Math.max(1, rect.height - window.innerHeight * 0.4);
        const value = Math.min(1, Math.max(0, (window.innerHeight * 0.25 - rect.top) / total));
        progress.style.transform = `scaleX(${value})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 95;
    height: 1px;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
  }

  .article__head {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(56px, 9vw, 104px));
    padding-bottom: clamp(42px, 6vw, 72px);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 62% 70% at 76% 10%, rgba(17, 62, 96, 0.28), transparent 68%),
      #02060d;
  }

  .article__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .article__back {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
  }

  .article__back:hover {
    color: var(--cyan);
  }

  .article__head .kicker {
    margin-top: clamp(30px, 5vw, 50px);
  }

  .article__title {
    max-width: 16em;
    margin-top: 18px;
    color: var(--ice);
    font-size: clamp(44px, 7vw, 92px);
    font-weight: 300;
    letter-spacing: 0.03em;
    line-height: 1.08;
  }

  .article__desc {
    max-width: 58ch;
    margin-top: 20px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.9;
  }

  .article__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 26px;
  }

  .article__meta .label {
    margin-left: 6px;
  }

  .article__layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 760px);
    justify-content: center;
    gap: clamp(28px, 5vw, 70px);
    padding-top: clamp(46px, 6vw, 76px);
    padding-bottom: clamp(64px, 9vw, 116px);
  }

  .article__toc {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    align-self: start;
    padding-top: 4px;
  }

  .article__toc .label {
    margin-bottom: 14px;
  }

  .article__toc nav {
    display: flex;
    flex-direction: column;
    gap: 7px;
    border-left: 1px solid var(--line);
  }

  .article__toc-link {
    margin-left: -1px;
    padding-left: 13px;
    border-left: 1px solid transparent;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .article__toc-link--3 {
    padding-left: 24px;
    color: var(--faint);
    font-size: 12px;
  }

  .article__toc-link:hover {
    border-left-color: var(--cyan);
    color: var(--ice);
  }

  .article__toc-top {
    display: inline-block;
    margin-top: 24px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .article__toc--empty span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  .article__body {
    min-width: 0;
  }

  .article__body .prose > :first-child {
    margin-top: 0;
  }

  .article__end {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 68px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .article__end .link {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .article__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-bottom: clamp(64px, 9vw, 110px);
  }

  .article__nav-item {
    display: flex;
    min-height: 120px;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    transition: border-color 0.2s ease;
  }

  .article__nav-item:hover {
    border-color: var(--cyan);
  }

  .article__nav-item strong {
    color: var(--ice);
    font-size: 20px;
    font-weight: 300;
    line-height: 1.4;
  }

  .article__nav-item--next {
    align-items: flex-end;
    text-align: right;
  }

  @media (max-width: 980px) {
    .article__layout {
      grid-template-columns: 1fr;
    }

    .article__toc {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .article__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .article__title {
      font-size: clamp(40px, 12vw, 56px);
    }

    .article__desc {
      font-size: 16px;
    }

    .article__nav {
      grid-template-columns: 1fr;
    }

    .article__nav-item--next {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
