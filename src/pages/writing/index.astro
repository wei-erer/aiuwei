---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from '../../components/PostRow.astro';
import { href } from '../../data/site';
import { getPosts } from '../../lib/content';

const posts = getPosts();
const count = String(posts.length).padStart(2, '0');
const hasPosts = posts.length > 0;
const categories = ['实验记录', '论文笔记', '项目复盘', 'AI 安全'];
---

<BaseLayout title="观测记录" description="AIUWEI 的观测记录：实验、论文笔记、项目复盘与 AI 安全方向的思考。">
  <PageHeader
    index="02"
    en="TRANSMISSIONS / WRITING"
    title="观测记录"
    titleEn="TRANSMISSIONS"
    description="实验、论文笔记、项目复盘，以及那些还没想清楚但值得留下的问题。所有记录按时间归档。"
    meta={[`LOGS ${count}`, 'LANGUAGE / ZH-CN', 'RSS / AVAILABLE']}
    stamp={`NOTES\n${count} LOGS`}
  />

  <section class="section">
    <div class="container">
      <div class="archive-bar" data-reveal>
        <p class="kicker">ARCHIVE INDEX / {hasPosts ? 'OPEN' : 'EMPTY'}</p>
        <a class="link" href={href('rss.xml')}>RSS FEED ↗</a>
      </div>

      {hasPosts ? (
        <div class="post-list">
          {posts.map((post, index) => <PostRow post={post} index={index} />)}
        </div>
      ) : (
        <div class="empty-log" data-reveal>
          <div class="empty-log__left">
            <p class="label">TRANSMISSIONS</p>
            <p class="empty-log__number">00</p>
            <p class="empty-log__status"><span class="status-dot"></span> CHANNEL OPEN</p>
          </div>

          <div class="empty-log__right">
            <p class="kicker">FIELD NOTE / 000</p>
            <h2>第一条记录，<br /><em>还在穿越深空。</em></h2>
            <p>
              这里会按时间存放实验记录、论文笔记和项目复盘。没有内容时，它就是一页留白的稿纸——不编造，也不凑数。
            </p>

            <div class="empty-log__categories">
              {categories.map((category, index) => (
                <span><i>{String(index + 1).padStart(2, '0')}</i>{category}</span>
              ))}
            </div>

            <div class="empty-log__paper" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
              <b>WAITING FOR FIRST TRANSMISSION</b>
            </div>

            <a class="link" href={href('about/')}>关于这座观测站 ↗</a>
          </div>
        </div>
      )}

      <div class="page-foot" data-reveal>
        <p class="label">TRANSMISSIONS / 记录会持续更新</p>
        <a class="link" href={href('lab/')}>去实验室玩一局 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .archive-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ink);
  }

  .archive-bar .link {
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .post-list {
    border-top: 1px solid var(--ink);
  }

  .empty-log {
    display: grid;
    grid-template-columns: minmax(200px, 0.42fr) minmax(0, 1.58fr);
    border-bottom: 1px solid var(--ink);
  }

  .empty-log__left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 26px 28px 26px 0;
    border-right: 1px solid var(--ink);
  }

  .empty-log__number {
    margin-block: auto;
    font-family: var(--font-sans);
    font-size: clamp(120px, 15vw, 200px);
    font-weight: 600;
    letter-spacing: -0.1em;
    line-height: 0.72;
  }

  .empty-log__status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange);
  }

  .empty-log__right {
    padding: clamp(26px, 4vw, 48px) 0 clamp(26px, 4vw, 48px) clamp(20px, 4vw, 48px);
  }

  .empty-log__right h2 {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.1;
  }

  .empty-log__right h2 em {
    background: linear-gradient(transparent 56%, var(--acid) 56%, var(--acid) 93%, transparent 93%);
    font-style: normal;
  }

  .empty-log__right > p:not(.kicker) {
    max-width: 56ch;
    margin-top: 18px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .empty-log__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .empty-log__categories span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
    font-size: 13px;
  }

  .empty-log__categories i {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    font-style: normal;
  }

  .empty-log__paper {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-top: 28px;
    padding: 20px 0 8px;
    border-top: 1px solid var(--ink);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 30px,
      var(--line) 30px,
      var(--line) 31px
    );
  }

  .empty-log__paper span {
    display: block;
    width: 100%;
  }

  .empty-log__paper b {
    align-self: flex-end;
    padding: 4px 7px;
    background: var(--ink);
    color: var(--paper-3);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .empty-log__right > .link {
    display: inline-block;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .page-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 54px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }

  .page-foot .link {
    font-family: var(--font-mono);
    font-size: 10px;
  }

  @media (max-width: 900px) {
    .empty-log {
      grid-template-columns: 1fr;
    }

    .empty-log__left {
      padding: 22px 0;
      border-right: 0;
      border-bottom: 1px solid var(--ink);
    }

    .empty-log__right {
      padding-left: 0;
    }
  }

  @media (max-width: 560px) {
    .archive-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .empty-log__number {
      font-size: 110px;
    }

    .empty-log__right h2 {
      font-size: 38px;
    }

    .page-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
