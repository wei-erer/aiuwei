---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { href } from '../../data/site';
import { getPosts, formatDate, readingTime } from '../../lib/content';

const posts = getPosts();
const count = String(posts.length).padStart(2, '0');
const hasPosts = posts.length > 0;
const categories = ['实验记录', '论文笔记', '项目复盘', 'AI 安全'];
---

<BaseLayout title="观测记录" description="AIUWEI 的观测记录：实验、论文笔记、项目复盘与 AI 安全方向的问题。">
  <PageHeader
    index="02"
    label="TRANSMISSIONS / WRITING"
    title="观测记录"
    titleEn="TRANSMISSIONS"
    description="实验、论文笔记、项目复盘，以及那些还没想清楚但值得留下的问题。所有记录按时间归档。"
    meta={[`LOG ${count}`, 'LANGUAGE / ZH-CN', 'RSS / OPEN']}
  />

  <section class="section">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">ARCHIVE / {hasPosts ? 'OPEN' : 'STANDBY'}</span>
        <a class="link" href={href('rss.xml')}>RSS ↗</a>
      </div>

      {hasPosts ? (
        <div class="log-list">
          {posts.map((post, index) => (
            <a class="log-row" href={href(`writing/${post.slug}/`)} data-reveal>
              <span class="log-row__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="log-row__body">
                <span class="log-row__meta">{formatDate(post.data.pubDate)} / {readingTime(post.raw)}</span>
                <strong>{post.data.title}</strong>
                {post.data.description && <span class="log-row__desc">{post.data.description}</span>}
              </span>
              <span class="log-row__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-log" data-reveal>
          <div class="empty-log__number">000</div>
          <div class="empty-log__copy">
            <p class="kicker">NO TRANSMISSION YET</p>
            <h2>还没有记录。</h2>
            <p>
              等第一篇文章写完，它会出现在这里。不用占位内容凑数，也不假装这里已经有人读过。
              记录会按时间排列，旧的往下沉，新的留在最上面。
            </p>
            <ul class="empty-log__categories" aria-label="计划收录的分类">
              {categories.map((category, index) => (
                <li><span>{String(index + 1).padStart(2, '0')}</span>{category}</li>
              ))}
            </ul>
            <a class="link" href={href('about/')}>关于这座观测站 ↗</a>
          </div>
        </div>
      )}

      <div class="page-foot" data-reveal>
        <span class="label">TRANSMISSIONS / 记录会持续更新</span>
        <a class="link" href={href('projects/')}>去看项目档案 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .log-list {
    margin-top: 22px;
    border-top: 1px solid var(--line);
  }

  .log-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.25s ease, padding-left 0.25s var(--ease);
  }

  .log-row:hover {
    padding-left: 10px;
    background: rgba(123, 220, 255, 0.035);
  }

  .log-row__index,
  .log-row__arrow {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .log-row__body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .log-row__meta {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .log-row__body strong {
    color: var(--ice);
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .log-row__desc {
    max-width: 54em;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .log-row__arrow {
    color: var(--cyan);
    font-size: 17px;
  }

  .empty-log {
    display: grid;
    grid-template-columns: minmax(200px, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: center;
    padding-block: clamp(38px, 6vw, 72px);
  }

  .empty-log__number {
    color: transparent;
    font-size: clamp(120px, 17vw, 250px);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 0.78;
    -webkit-text-stroke: 1px rgba(160, 224, 250, 0.5);
  }

  .empty-log__copy h2 {
    margin-top: 12px;
    color: var(--ice);
    font-size: clamp(42px, 5.6vw, 76px);
    font-weight: 300;
    letter-spacing: 0.03em;
  }

  .empty-log__copy > p:not(.kicker) {
    max-width: 40em;
    margin-top: 18px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .empty-log__categories {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
    max-width: 470px;
    margin-top: 26px;
    border-top: 1px solid var(--line);
  }

  .empty-log__categories li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  .empty-log__categories span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .empty-log__copy .link {
    margin-top: 26px;
  }

  .page-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(48px, 7vw, 86px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .empty-log {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .empty-log__number {
      font-size: 148px;
    }

    .empty-log__copy h2 {
      font-size: 50px;
    }

    .empty-log__categories {
      grid-template-columns: 1fr;
    }

    .log-row {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 14px;
    }

    .log-row__arrow {
      display: none;
    }

    .page-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
