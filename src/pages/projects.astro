---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { href } from '../data/site';
import { projects } from '../content/projects';

const ordered = [...projects].sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
const count = String(ordered.length).padStart(2, '0');
---

<BaseLayout title="项目档案" description="AIUWEI 的项目档案：实验、工具与独立项目。">
  <PageHeader
    index="01"
    en="MISSION FILES / PROJECTS"
    title="项目档案"
    titleEn="MISSION FILES"
    description="实验、工具与独立项目。每份档案都尽量留下问题、方法、结果和可验证的链接，而不是一句“我很厉害”。"
    meta={[`ARCHIVED ${count}`, 'STATUS / OPEN', 'FORMAT / PROBLEM → METHOD → RESULT']}
    stamp={`OPEN\n${count} FILES`}
  />

  <section class="section">
    <div class="container">
      <div class="index-bar" data-reveal>
        <div>
          <p class="kicker">MISSION INDEX</p>
          <p class="index-bar__count">{count} <span>FILES</span></p>
        </div>
        <div class="index-bar__legend">
          <span><i class="legend-dot legend-dot--active"></i>进行中</span>
          <span><i class="legend-dot legend-dot--experiment"></i>实验中</span>
          <span><i class="legend-dot legend-dot--archived"></i>已归档</span>
        </div>
      </div>

      {ordered.length > 0 ? (
        <div class="project-grid">
          {ordered.map((project, index) => (
            <ProjectCard project={project} accent={index % 3 === 0 ? 'acid' : index % 3 === 1 ? 'blue' : 'orange'} />
          ))}
        </div>
      ) : (
        <div class="empty-missions" data-reveal>
          <div class="empty-missions__slots">
            {[1, 2, 3].map((slot) => (
              <article class:list={['empty-slot', slot === 1 ? 'empty-slot--acid' : slot === 2 ? 'empty-slot--blue' : 'empty-slot--orange']}>
                <div class="empty-slot__top">
                  <span class="mono">SLOT {String(slot).padStart(2, '0')}</span>
                  <span class="tag">OPEN</span>
                </div>
                <p class="empty-slot__number">{String(slot).padStart(2, '0')}</p>
                <div class="empty-slot__lines" aria-hidden="true"><span></span><span></span><span></span></div>
                <p class="empty-slot__note">等待任务归档</p>
              </article>
            ))}
          </div>

          <aside class="empty-missions__note">
            <p class="kicker">MISSION CONTROL / STANDBY</p>
            <h2>第一份任务档案，<br /><em>还在路上。</em></h2>
            <p>
              这里不会用虚构项目填满。等第一个实验、工具或独立项目被整理成可验证的档案，它才会出现在这里。
            </p>
            <ol class="mission-protocol">
              <li><span>01</span>它解决了什么问题</li>
              <li><span>02</span>用了什么方法</li>
              <li><span>03</span>留下了什么结果</li>
            </ol>
            <a class="link" href={href('about/')}>认识记录者 ↗</a>
          </aside>
        </div>
      )}

      <div class="page-foot" data-reveal>
        <p class="label">PROJECTS / AIUWEI OBSERVATORY</p>
        <a class="link" href={href('writing/')}>去看观测记录 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .index-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--ink);
  }

  .index-bar__count {
    margin-top: 10px;
    font-family: var(--font-sans);
    font-size: 46px;
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .index-bar__count span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .index-bar__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .index-bar__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--ink);
    background: var(--acid);
  }

  .legend-dot--experiment {
    background: var(--orange);
  }

  .legend-dot--archived {
    background: var(--paper-2);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 28px;
  }

  .empty-missions {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: 18px;
    margin-top: 28px;
  }

  .empty-missions__slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .empty-slot {
    display: flex;
    min-height: 430px;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--ink);
    background: var(--paper-3);
  }

  .empty-slot--acid {
    border-top: 10px solid var(--acid);
  }

  .empty-slot--blue {
    border-top: 10px solid var(--blue);
  }

  .empty-slot--orange {
    border-top: 10px solid var(--orange);
  }

  .empty-slot__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .empty-slot__number {
    margin-block: auto;
    font-family: var(--font-sans);
    font-size: 86px;
    font-weight: 600;
    letter-spacing: -0.09em;
    line-height: 0.8;
  }

  .empty-slot__lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .empty-slot__lines span {
    height: 1px;
    background: var(--line);
  }

  .empty-slot__lines span:nth-child(2) {
    width: 72%;
  }

  .empty-slot__lines span:nth-child(3) {
    width: 45%;
  }

  .empty-slot__note {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.03em;
  }

  .empty-missions__note {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 3.4vw, 40px);
    border: 1px solid var(--ink);
    background: var(--acid);
  }

  .empty-missions__note h2 {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.15;
  }

  .empty-missions__note h2 em {
    font-style: normal;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .empty-missions__note > p:not(.kicker) {
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.9;
  }

  .mission-protocol {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 22px;
    border-top: 1px solid var(--ink);
  }

  .mission-protocol li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 14px;
  }

  .mission-protocol span {
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .empty-missions__note .link {
    align-self: flex-start;
    margin-top: 22px;
    color: var(--ink);
    border-color: var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .page-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 54px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }

  .page-foot .link {
    font-family: var(--font-mono);
    font-size: 10px;
  }

  @media (max-width: 1000px) {
    .empty-missions {
      grid-template-columns: 1fr;
    }

    .empty-missions__note {
      min-height: 300px;
    }
  }

  @media (max-width: 760px) {
    .index-bar {
      align-items: flex-start;
      flex-direction: column;
    }

    .empty-missions__slots {
      grid-template-columns: 1fr;
    }

    .empty-slot {
      min-height: 200px;
    }

    .empty-slot__number {
      font-size: 64px;
    }

    .page-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
