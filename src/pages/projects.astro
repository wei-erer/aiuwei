---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { href } from '../data/site';
import { projects } from '../content/projects';

const ordered = [...projects].sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
const count = String(ordered.length).padStart(2, '0');
const hasProjects = ordered.length > 0;
---

<BaseLayout title="项目档案" description="AIUWEI 的任务档案：实验、工具与独立项目。">
  <PageHeader
    index="01"
    en="MISSION FILES / PROJECTS"
    title="项目档案"
    titleEn="MISSION FILES"
    description="实验、工具与独立项目。每份档案都应当能被验证：它解决了什么问题，用了什么方法，留下了什么结果。"
    meta={[`MISSIONS ${count}`, 'STATUS / STANDBY', 'UPLINK / GITHUB']}
  />

  <section class="section projects-page">
    <div class="container">
      <div class="projects-page__bar" data-reveal>
        <div>
          <p class="eyebrow">MISSION INDEX</p>
          <p class="projects-page__count">{count} <span>FILES ARCHIVED</span></p>
        </div>
        <div class="projects-page__legend">
          <span><i class="dot dot--active"></i> ACTIVE</span>
          <span><i class="dot dot--experiment"></i> EXPERIMENT</span>
          <span><i class="dot dot--archived"></i> ARCHIVED</span>
        </div>
      </div>

      {hasProjects ? (
        <div class="projects-page__grid">
          {ordered.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <div class="missions">
          <div class="missions__slots" data-reveal>
            {[1, 2, 3].map((slot) => (
              <div class="project-slot">
                <span class="project-slot__index">SLOT {String(slot).padStart(2, '0')}</span>
                <span class="project-slot__plus" aria-hidden="true">+</span>
                <span class="project-slot__bottom"><span>STATUS</span><strong>OPEN</strong></span>
                <span class="project-slot__line" aria-hidden="true"></span>
              </div>
            ))}
          </div>

          <aside class="missions__aside panel" data-reveal style="--delay: 0.1s">
            <span class="hud-corners" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
            <div>
              <p class="eyebrow">MISSION CONTROL / STANDBY</p>
              <h2>槽位已开启，<br />等待第一份档案。</h2>
              <p>
                这里不会用虚构的项目填满。等 wei_er 把第一个实验、工具或独立项目整理成可验证的档案，它才会出现在这里。
              </p>
            </div>

            <ul class="missions__list">
              <li><span>01</span>它解决了什么问题</li>
              <li><span>02</span>用了什么方法</li>
              <li><span>03</span>留下了什么结果</li>
            </ul>

            <div class="missions__terminal terminal">
              <span>wei_er@aiuwei:~$ ls /missions --all</span><span class="caret" aria-hidden="true"></span>
            </div>
          </aside>
        </div>
      )}

      <div class="projects-page__footer" data-reveal>
        <p>项目会持续归档。</p>
        <a class="projects-page__link" href={href('about/')}>认识记录者 <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page__bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .projects-page__count {
    margin-top: 12px;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 32px;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .projects-page__count span {
    color: var(--ink-faint);
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .projects-page__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .projects-page__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cyan);
  }

  .dot--experiment {
    background: var(--amber);
  }

  .dot--archived {
    background: var(--ink-faint);
  }

  .projects-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .missions {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 16px;
    margin-top: 32px;
  }

  .missions__slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .project-slot {
    position: relative;
    display: flex;
    min-height: 420px;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    border: 1px dashed var(--line);
    background:
      linear-gradient(150deg, rgba(100, 244, 223, 0.03), transparent 48%),
      rgba(5, 12, 22, 0.24);
    overflow: hidden;
    transition: border-color 0.35s ease, background-color 0.35s ease;
  }

  .project-slot::before {
    content: '';
    position: absolute;
    inset: 20px;
    border: 1px solid rgba(100, 244, 223, 0.045);
    pointer-events: none;
  }

  .project-slot:hover {
    border-color: var(--line-strong);
    background-color: rgba(8, 20, 34, 0.5);
  }

  .project-slot__index,
  .project-slot__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }

  .project-slot__plus {
    position: relative;
    z-index: 1;
    align-self: center;
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: 38px;
    font-weight: 300;
    line-height: 1;
    transition: color 0.35s ease, transform 0.35s var(--ease);
  }

  .project-slot:hover .project-slot__plus {
    color: var(--cyan);
    transform: rotate(90deg);
  }

  .project-slot__bottom strong {
    color: var(--ink-muted);
    font-weight: 400;
  }

  .project-slot__line {
    position: absolute;
    top: 50%;
    left: 20px;
    right: 20px;
    height: 1px;
    background: linear-gradient(to right, var(--line), transparent);
    pointer-events: none;
  }

  .missions__aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 30px;
    padding: clamp(24px, 3vw, 40px);
  }

  .missions__aside h2 {
    margin-top: 24px;
    font-family: var(--font-cn);
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 1.3;
  }

  .missions__aside p:not(.eyebrow) {
    margin-top: 18px;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 13px;
    line-height: 1.95;
  }

  .missions__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .missions__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-cn);
    font-size: 12px;
  }

  .missions__list span {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 8px;
    opacity: 0.6;
  }

  .missions__terminal {
    padding-top: 18px;
    border-top: 1px solid var(--line);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.8;
  }

  .projects-page__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .projects-page__link {
    color: var(--ink-muted);
    transition: color 0.3s ease;
  }

  .projects-page__link span {
    color: var(--cyan);
  }

  .projects-page__link:hover {
    color: var(--cyan);
  }

  @media (max-width: 1120px) {
    .missions {
      grid-template-columns: 1fr;
    }

    .missions__aside {
      min-height: 360px;
    }
  }

  @media (max-width: 760px) {
    .projects-page__bar {
      align-items: flex-start;
      flex-direction: column;
    }

    .missions__slots {
      grid-template-columns: 1fr;
    }

    .project-slot {
      min-height: 150px;
    }

    .project-slot__line {
      display: none;
    }
  }
</style>
