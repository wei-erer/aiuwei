---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { href } from '../data/site';
import { projects } from '../content/projects';

const ordered = [...projects].sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
const count = String(ordered.length).padStart(2, '0');
---

<BaseLayout title="项目档案" description="AIUWEI 的项目档案：实验、工具与独立项目，按问题、方法和结果归档。">
  <PageHeader
    index="01"
    label="MISSION FILES / PROJECTS"
    title="项目档案"
    titleEn="MISSION FILES"
    description="实验、工具与独立项目。每份档案都尽量留下问题、方法、结果和可验证的链接，而不是一句“我很厉害”。"
    meta={[`档案 ${count}`, '状态 / 开放', '格式 / 问题 → 方法 → 结果']}
  />

  <section class="section">
    <div class="container">
      <div class="section-label" data-reveal>
        <span class="section-label__index">项目索引 / {count} 份档案</span>
        <span class="section-label__meta">仅收录可验证项目</span>
      </div>

      {ordered.length > 0 ? (
        <div class="manifest">
          {ordered.map((project, index) => (
            <article class="manifest-row" data-reveal>
              <span class="manifest-row__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="manifest-row__body">
                <div class="manifest-row__top">
                  <h2>{project.title}</h2>
                  <span class="tag tag--live">{project.status}</span>
                </div>
                <p>{project.description}</p>
                <div class="manifest-row__meta">
                  <span>{project.year}</span>
                  {project.stack.map((item) => <span>{item}</span>)}
                  {project.repo && <a href={project.repo} target="_blank" rel="noreferrer">REPO ↗</a>}
                  {project.link && <a href={project.link} target="_blank" rel="noreferrer">OPEN ↗</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-missions" data-reveal>
          <div class="empty-missions__top">
            <span class="empty-missions__number">000</span>
            <div>
              <p class="kicker">待命 / 尚无已验证档案</p>
              <h2>任务档案<br />尚未归档。</h2>
            </div>
          </div>

          <div class="empty-missions__lines" aria-hidden="true">
            <span><i>001</i><b></b><em>—</em></span>
            <span><i>002</i><b></b><em>—</em></span>
            <span><i>003</i><b></b><em>—</em></span>
          </div>

          <div class="empty-missions__copy">
            <p>
              这里不会用虚构项目填满。等第一个实验、工具或独立项目被整理成可验证的档案，
              它才会出现在这里。没有链接、没有实验条件的项目，不算档案。
            </p>
            <ol class="protocol">
              <li><span>01</span>它解决了什么问题</li>
              <li><span>02</span>用了什么方法</li>
              <li><span>03</span>留下了什么结果</li>
            </ol>
            <a class="link" href={href('about/')}>认识记录者 ↗</a>
          </div>
        </div>
      )}

      <div class="page-foot" data-reveal>
        <span class="label">项目档案 / AIUWEI OBSERVATORY</span>
        <a class="link" href={href('writing/')}>去看观测记录 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .manifest {
    margin-top: 22px;
    border-top: 1px solid var(--line);
  }

  .manifest-row {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .manifest-row__index {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .manifest-row__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .manifest-row__top h2 {
    color: var(--ice);
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: 300;
  }

  .manifest-row__body > p {
    max-width: 54em;
    margin-top: 9px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.8;
  }

  .manifest-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 16px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .manifest-row__meta a {
    color: var(--cyan);
  }

  .empty-missions {
    display: block;
    padding-block: clamp(40px, 7vw, 80px);
  }

  .empty-missions__top {
    display: flex;
    align-items: flex-start;
    gap: clamp(24px, 4vw, 54px);
    margin-bottom: 42px;
  }

  .empty-missions__top > div {
    min-width: 0;
    flex: 1 1 auto;
  }

  .empty-missions__number {
    flex: 0 0 auto;
    color: transparent;
    font-size: clamp(100px, 14vw, 196px);
    font-weight: 300;
    line-height: 0.78;
    -webkit-text-stroke: 1px rgba(160, 224, 250, 0.48);
  }

  .empty-missions__top h2 {
    margin-top: 12px;
    color: var(--ice);
    font-size: clamp(34px, 3.8vw, 52px);
    font-weight: 300;
    line-height: 1.25;
    text-wrap: balance;
  }

  .empty-missions__lines {
    border-top: 1px solid var(--line);
  }

  .empty-missions__lines span {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .empty-missions__lines i {
    color: var(--faint);
    font-style: normal;
  }

  .empty-missions__lines b {
    height: 1px;
    background: linear-gradient(90deg, var(--line), transparent);
  }

  .empty-missions__lines em {
    color: var(--faint);
    font-style: normal;
  }

  .empty-missions__copy {
    max-width: 620px;
    padding-top: 42px;
  }

  .empty-missions__copy > p {
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .protocol {
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }

  .protocol li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }

  .protocol span {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .empty-missions__copy .link {
    margin-top: 26px;
  }

  .page-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(48px, 7vw, 86px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .empty-missions__copy {
      padding-top: 0;
    }
  }

  @media (max-width: 700px) {
    .manifest-row {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 14px;
    }

    .manifest-row__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .empty-missions__top {
      flex-direction: column;
      gap: 22px;
      margin-bottom: 30px;
    }

    .empty-missions__number {
      font-size: 128px;
    }

    .empty-missions__top h2 {
      font-size: 44px;
    }
    .page-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
