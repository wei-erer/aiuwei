---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../data/site';
---

<BaseLayout title="信号丢失" description="404：这个坐标上没有可读取的信号。">
  <section class="not-found">
    <div class="not-found__grid" aria-hidden="true"></div>
    <div class="container not-found__inner">
      <p class="eyebrow"><span class="status-dot status-dot--amber"></span> SIGNAL LOST / 404</p>
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>这个坐标上<br />没有可读取的信号。</h1>
      <p class="not-found__desc">可能是链接写错了，也可能是这份记录还没被上传。回到观测站，重新校准坐标。</p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href={href('')}>返回首页</a>
        <a class="btn btn--ghost" href={href('writing/')}>读取观测记录</a>
      </div>
      <p class="not-found__terminal terminal">wei_er@aiuwei:~$ locate signal --id 404<span class="caret" aria-hidden="true"></span></p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    padding-top: var(--nav-h);
  }

  .not-found__grid {
    position: absolute;
    inset: 0;
    opacity: 0.26;
    background-image:
      linear-gradient(to right, rgba(100, 244, 223, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(100, 244, 223, 0.04) 1px, transparent 1px);
    background-size: 90px 90px;
    mask-image: radial-gradient(ellipse at center, black, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse at center, black, transparent 72%);
    pointer-events: none;
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    padding-block: 80px;
    text-align: center;
  }

  .not-found__inner .eyebrow {
    justify-content: center;
  }

  .not-found__code {
    margin-top: 24px;
    color: transparent;
    font-family: var(--font-mono);
    font-size: clamp(120px, 26vw, 320px);
    font-weight: 400;
    letter-spacing: -0.1em;
    line-height: 0.75;
    -webkit-text-stroke: 1px rgba(100, 244, 223, 0.24);
  }

  .not-found h1 {
    margin-top: 10px;
    font-family: var(--font-cn);
    font-size: clamp(30px, 4.4vw, 54px);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 1.3;
  }

  .not-found__desc {
    max-width: 46ch;
    margin: 22px auto 0;
    color: var(--ink-muted);
    font-family: var(--font-cn);
    font-size: 13px;
    line-height: 1.95;
  }

  .not-found__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .not-found__terminal {
    margin-top: 40px;
    color: var(--ink-faint);
    font-size: 8px;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  @media (max-width: 560px) {
    .not-found__actions {
      flex-direction: column;
    }
  }
</style>
