---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../data/site';
---

<BaseLayout title="页面走丢了" description="404：这个坐标上没有可读取的内容。">
  <section class="not-found">
    <div class="container not-found__inner">
      <div class="not-found__top">
        <p class="kicker">SIGNAL LOST / 404</p>
        <span class="label">AIUWEI OBSERVATORY</span>
      </div>

      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>这个坐标上<br /><em>没有可读取的内容。</em></h1>
      <p class="not-found__desc">可能是链接写错了，也可能是这份记录还没被上传。回到封面，重新校准坐标。</p>

      <div class="not-found__actions">
        <a class="btn btn--solid" href={href('')}><span>返回封面</span><span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn" href={href('writing/')}><span>去看观测记录</span><span class="btn__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding-top: var(--nav-h);
  }

  .not-found__inner {
    padding-block: 60px;
  }

  .not-found__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ink);
  }

  .not-found__code {
    margin-top: 34px;
    font-family: var(--font-sans);
    font-size: clamp(140px, 28vw, 360px);
    font-weight: 600;
    letter-spacing: -0.12em;
    line-height: 0.7;
  }

  .not-found h1 {
    max-width: 12em;
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: clamp(38px, 5.6vw, 78px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.15;
  }

  .not-found h1 em {
    background: linear-gradient(transparent 56%, var(--acid) 56%, var(--acid) 93%, transparent 93%);
    font-style: normal;
  }

  .not-found__desc {
    max-width: 46ch;
    margin-top: 20px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  @media (max-width: 560px) {
    .not-found__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .not-found__actions {
      flex-direction: column;
    }
  }
</style>
