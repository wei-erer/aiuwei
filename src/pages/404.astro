---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../data/site';
---

<BaseLayout title="信号丢失" description="404 — 没有找到这条信号。">
  <section class="lost">
    <div class="lost__scene" aria-hidden="true">
      <div class="lost__stars"></div>
      <div class="lost__orbit"></div>
      <div class="lost__planet"></div>
    </div>
    <div class="container lost__inner">
      <p class="kicker">ERROR / SIGNAL LOST</p>
      <p class="lost__code">404</p>
      <h1>这条信号<br /><em>没有抵达观测站。</em></h1>
      <p class="lost__copy">它可能被移动、删除，或者从来就不在这条轨道上。</p>
      <div class="lost__actions">
        <a class="btn btn--solid" href={href('')}><span>返回观测站</span><span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="link" href={href('writing/')}>查看观测记录 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #02060d;
  }

  .lost__scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .lost__stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(220, 245, 255, 0.7) 0.8px, transparent 0.8px),
      radial-gradient(rgba(150, 215, 245, 0.5) 0.6px, transparent 0.6px);
    background-size: 71px 61px, 131px 103px;
    opacity: 0.45;
  }

  .lost__planet {
    position: absolute;
    right: -500px;
    bottom: -1000px;
    width: 1500px;
    height: 1500px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 23%, #d9f8ff 0, #52b5df 18%, #1d5d84 40%, #051b2d 68%, #010409 84%);
    opacity: 0.62;
  }

  .lost__orbit {
    position: absolute;
    right: -180px;
    top: 18%;
    width: 1000px;
    height: 380px;
    border: 1px solid rgba(123, 220, 255, 0.28);
    border-radius: 50%;
    transform: rotate(-14deg);
  }

  .lost__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-top: var(--nav-h);
    padding-bottom: 60px;
  }

  .lost__code {
    margin-top: 24px;
    color: transparent;
    font-family: var(--font-mono);
    font-size: clamp(110px, 20vw, 260px);
    font-weight: 300;
    line-height: 0.8;
    -webkit-text-stroke: 1px rgba(160, 224, 250, 0.5);
  }

  .lost h1 {
    margin-top: 26px;
    color: var(--ice);
    font-size: clamp(48px, 7vw, 98px);
    font-weight: 300;
    line-height: 1.1;
  }

  .lost h1 em {
    color: var(--cyan);
    font-style: normal;
  }

  .lost__copy {
    max-width: 36em;
    margin-top: 20px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.9;
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
    margin-top: 30px;
  }

  @media (max-width: 700px) {
    .lost h1 {
      font-size: 46px;
    }

    .lost__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    .lost__actions .btn {
      width: 100%;
    }
  }
</style>
